                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#059669" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="초보자 안심 가이드" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="🧙‍♂️ 원클릭 안전 백업 마법사" Foreground="#f8fafc" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="어려운 Robocopy 명령어 없이 용도에 맞게 5단계로 안전하게 백업을 완성합니다." Foreground="#94a3b8" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding CloseEasyWizardCommand}" Background="#334155" Foreground="#f8fafc" Padding="12,5" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" HorizontalAlignment="Right">
                            <TextBlock Text="✕ 닫기" FontWeight="Bold"/>
                        </Button>
                    </DockPanel>

                    <!-- 5-Step Progress Bar -->
                    <Border Grid.Row="1" Background="#1e293b" CornerRadius="10" Padding="10" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#334155">
                        <UniformGrid Columns="5">
                            <Border Background="{Binding EasyStep1Brush}" CornerRadius="6" Padding="6,6" Margin="0,0,4,0">
                                <TextBlock Text="1️⃣ 용도 선택" Foreground="White" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                            <Border Background="{Binding EasyStep2Brush}" CornerRadius="6" Padding="6,6" Margin="2,0,2,0">
                                <TextBlock Text="2️⃣ 폴더 지정" Foreground="White" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                            <Border Background="{Binding EasyStep3Brush}" CornerRadius="6" Padding="6,6" Margin="2,0,2,0">
                                <TextBlock Text="3️⃣ 모드 &amp; 속도" Foreground="White" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                            <Border Background="{Binding EasyStep4Brush}" CornerRadius="6" Padding="6,6" Margin="2,0,2,0">
                                <TextBlock Text="4️⃣ 사전 점검" Foreground="White" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                            <Border Background="{Binding EasyStep5Brush}" CornerRadius="6" Padding="6,6" Margin="4,0,0,0">
                                <TextBlock Text="5️⃣ 백업 실행" Foreground="White" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                        </UniformGrid>
                    </Border>

                    <!-- Wizard Dynamic Content Area -->
                    <Border Grid.Row="2" Background="#1e293b" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#334155" MinHeight="320">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- STEP 1: 백업 목적 선택 -->
                                <StackPanel Visibility="{Binding EasyStep1Active, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="어떤 용도로 백업을 진행하시겠습니까?" Foreground="#f8fafc" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="용도에 가장 알맞은 최적의 Robocopy 플래그와 안전 보호 설정이 자동 구성됩니다." Foreground="#94a3b8" FontSize="12" Margin="0,0,0,16"/>

                                    <UniformGrid Columns="2" Margin="0,0,0,16">
                                        <!-- 1. USB/외장하드 -->
                                        <Button Command="{Binding EasyWizardSelectPurposeCommand}" CommandParameter="usb"
                                                Background="{Binding PurposeUsbBg}" BorderBrush="{Binding PurposeUsbBorder}" BorderThickness="2"
                                                Padding="14,12" Margin="0,0,6,8" Cursor="Hand" HorizontalContentAlignment="Left">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="💾 " FontSize="16"/>
                                                    <TextBlock Text="외장하드 / USB 백업" FontSize="13" FontWeight="Bold" Foreground="#6ee7b7"/>
                                                </StackPanel>
                                                <TextBlock Text="USB FAT/exFAT 파일시스템 2초 타임스탬프 차이 방지(/FFT) 자동 적용" Foreground="#94a3b8" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 2. NAS 네트워크 -->
                                        <Button Command="{Binding EasyWizardSelectPurposeCommand}" CommandParameter="nas"
                                                Background="{Binding PurposeNasBg}" BorderBrush="{Binding PurposeNasBorder}" BorderThickness="2"
                                                Padding="14,12" Margin="6,0,0,8" Cursor="Hand" HorizontalContentAlignment="Left">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="🌐 " FontSize="16"/>
                                                    <TextBlock Text="NAS 네트워크 백업" FontSize="13" FontWeight="Bold" Foreground="#93c5fd"/>
                                                </StackPanel>
                                                <TextBlock Text="네트워크 지연 무한 멈춤 방지(/R:1 /W:1) 및 안정적 재시도 보호" Foreground="#94a3b8" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 3. 완벽 1:1 미러 -->
                                        <Button Command="{Binding EasyWizardSelectPurposeCommand}" CommandParameter="mirror"
                                                Background="{Binding PurposeMirrorBg}" BorderBrush="{Binding PurposeMirrorBorder}" BorderThickness="2"
                                                Padding="14,12" Margin="0,4,6,0" Cursor="Hand" HorizontalContentAlignment="Left">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="⚡ " FontSize="16"/>
                                                    <TextBlock Text="1:1 완벽 미러 동기화" FontSize="13" FontWeight="Bold" Foreground="#f0abfc"/>
                                                </StackPanel>
                                                <TextBlock Text="원본 폴더와 100% 일치 동기화 (원본에서 삭제된 파일 대상에서도 삭제)" Foreground="#94a3b8" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 4. 문서/사진 단순 보관 -->
                                        <Button Command="{Binding EasyWizardSelectPurposeCommand}" CommandParameter="archive"
                                                Background="{Binding PurposeArchiveBg}" BorderBrush="{Binding PurposeArchiveBorder}" BorderThickness="2"
                                                Padding="14,12" Margin="6,4,0,0" Cursor="Hand" HorizontalContentAlignment="Left">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="📦 " FontSize="16"/>
                                                    <TextBlock Text="안전 누적 보관 백업" FontSize="13" FontWeight="Bold" Foreground="#fcd34d"/>
                                                </StackPanel>
                                                <TextBlock Text="대상 폴더의 기존 파일을 절대 지우지 않고 새 파일만 차곡차곡 누적" Foreground="#94a3b8" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <!-- Selected Purpose Info Box -->
                                    <Border Background="#0f172a" BorderBrush="#059669" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding EasyWizardPurposeTitle}" Foreground="#34d399" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding EasyWizardPurposeDesc}" Foreground="#e2e8f0" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- STEP 2: 폴더 지정 및 유효성 검사 -->
                                <StackPanel Visibility="{Binding EasyStep2Active, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="백업할 원본 폴더와 저장할 대상 폴더를 선택하세요." Foreground="#f8fafc" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="동일 폴더 지정이나 하위 폴더 중복 지정을 자동 검사하여 데이터 유실을 사전 차단합니다." Foreground="#94a3b8" FontSize="12" Margin="0,0,0,16"/>

                                    <!-- Source Folder -->
                                    <TextBlock Text="📂 원본 폴더 (Source - 복사해올 폴더)" Foreground="#6ee7b7" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <DockPanel Margin="0,0,0,16">
                                        <Button DockPanel.Dock="Right" Command="{Binding EasyWizardBrowseSourceCommand}" Content="📁 폴더 찾기" Background="#059669" Foreground="White" FontWeight="Bold" Padding="14,8" Cursor="Hand" Margin="8,0,0,0"/>
                                        <TextBox Text="{Binding EasyWizardSourcePath, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,8" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" BorderThickness="1"/>
                                    </DockPanel>

                                    <!-- Destination Folder -->
                                    <TextBlock Text="🎯 대상 폴더 (Destination - 저장될 백업 폴더)" Foreground="#60a5fa" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <DockPanel Margin="0,0,0,16">
                                        <Button DockPanel.Dock="Right" Command="{Binding EasyWizardBrowseTargetCommand}" Content="📁 폴더 찾기" Background="#2563eb" Foreground="White" FontWeight="Bold" Padding="14,8" Cursor="Hand" Margin="8,0,0,0"/>
                                        <TextBox Text="{Binding EasyWizardTargetPath, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,8" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" BorderThickness="1"/>
                                    </DockPanel>

                                    <!-- Warning Banner if invalid path -->
                                    <Border Background="#450a0a" BorderBrush="#ef4444" BorderThickness="1.5" CornerRadius="8" Padding="12" Visibility="{Binding HasPathWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠️ " FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding EasyWizardPathWarning}" Foreground="#fca5a5" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- STEP 3: 백업 모드 및 속도 설정 -->
                                <StackPanel Visibility="{Binding EasyStep3Active, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="백업 방식과 복사 속도 옵션을 확인하세요." Foreground="#f8fafc" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="초보자에게는 기존 파일 삭제 우려가 없는 '안전 증분 백업'을 강력 권장합니다." Foreground="#94a3b8" FontSize="12" Margin="0,0,0,16"/>

                                    <UniformGrid Columns="2" Margin="0,0,0,16">
                                        <!-- Mode 1: 증분 백업 -->
                                        <RadioButton IsChecked="{Binding IsModeIncremental, Mode=TwoWay}" GroupName="EasyModeGroup" Margin="0,0,8,0">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border Background="{Binding DataContext.ModeIncBg, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{Binding DataContext.ModeIncBorder, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="2" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Text="🛡️ " FontSize="16"/>
                                                                <TextBlock Text="안전 증분 백업 (권장)" FontSize="13" FontWeight="Bold" Foreground="#34d399"/>
                                                            </StackPanel>
                                                            <TextBlock Text="새 파일과 수정된 파일만 복사. 대상에만 있는 파일은 절대 삭제하지 않음." Foreground="#94a3b8" FontSize="11" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>

                                        <!-- Mode 2: 완벽 미러 -->
                                        <RadioButton IsChecked="{Binding IsModeMirror, Mode=TwoWay}" GroupName="EasyModeGroup" Margin="8,0,0,0">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border Background="{Binding DataContext.ModeMirBg, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{Binding DataContext.ModeMirBorder, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="2" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Text="⚡ " FontSize="16"/>
                                                                <TextBlock Text="1:1 완벽 미러링 (/MIR)" FontSize="13" FontWeight="Bold" Foreground="#f87171"/>
                                                            </StackPanel>
                                                            <TextBlock Text="원본과 100% 동일화. 원본에서 지워진 파일은 대상에서도 영구 삭제됨." Foreground="#94a3b8" FontSize="11" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </UniformGrid>

                                    <!-- Safe Speed Toggles -->
                                    <Border Background="#0f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                        <StackPanel>
                                            <TextBlock Text="⚡ 초보자 안심 속도 및 안정성 보정" Foreground="#60a5fa" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <CheckBox IsChecked="{Binding EasyWizardMultiThread}" Margin="0,0,0,8">
                                                <TextBlock Text="멀티스레드 고속 복사 활성화 (/MT:8) - 여러 파일을 병렬로 빠르게 복사" Foreground="#f8fafc" FontSize="12"/>
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding EasyWizardPreventLock}" Margin="0,0,0,8">
                                                <TextBlock Text="파일 사용 중 무한 대기 방지 (/R:1 /W:1) - 다른 프로그램이 열고 있는 파일 건너뛰기" Foreground="#f8fafc" FontSize="12"/>
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding EasyWizardFft}">
                                                <TextBlock Text="타임스탬프 2초 오차 보정 (/FFT) - 외장하드/USB FAT 파일시스템 오차 무시" Foreground="#f8fafc" FontSize="12"/>
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- STEP 4: 사전 점검 및 시뮬레이션 -->
                                <StackPanel Visibility="{Binding EasyStep4Active, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="실제 복사 전 사전 점검(Dry-Run) 결과입니다." Foreground="#f8fafc" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="실제 파일 변경 없이 안전하게 예상 복사 수량과 용량을 사전 검증했습니다." Foreground="#94a3b8" FontSize="12" Margin="0,0,0,16"/>

                                    <UniformGrid Columns="4" Margin="0,0,0,16">
                                        <Border Background="#0f172a" BorderBrush="#10b981" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="0,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="복사 예정 파일" Foreground="#94a3b8" FontSize="11" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding EasyWizardSimFiles}" Foreground="#34d399" FontSize="18" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0f172a" BorderBrush="#3b82f6" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="2,0,2,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="예상 복사 용량" Foreground="#94a3b8" FontSize="11" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding EasyWizardSimBytes}" Foreground="#60a5fa" FontSize="18" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0f172a" BorderBrush="#ef4444" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="2,0,2,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="삭제 예정 파일" Foreground="#94a3b8" FontSize="11" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding EasyWizardSimDeletes}" Foreground="#f87171" FontSize="18" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0f172a" BorderBrush="#eab308" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="4,0,0,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="예상 소요 시간" Foreground="#94a3b8" FontSize="11" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding EasyWizardSimSeconds, StringFormat='약 {0}초'}" Foreground="#facc15" FontSize="18" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Status Message -->
                                    <Border Background="#0f172a" BorderBrush="#059669" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding EasyWizardSimLog}" Foreground="#e2e8f0" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Generated Command Preview -->
                                    <TextBlock Text="생성된 Robocopy 명령어:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EasyWizardGeneratedCommand, Mode=OneWay}" IsReadOnly="True" Background="#020617" Foreground="#38bdf8" FontFamily="Consolas" FontSize="12" Padding="10,6" BorderBrush="#334155" Margin="0,0,0,10"/>

                                    <Button Command="{Binding EasyWizardRunSimCommand}" Content="🔄 시뮬레이션 다시 실행" Background="#334155" Foreground="White" Padding="14,6" HorizontalAlignment="Left" Cursor="Hand"/>
                                </StackPanel>

                                <!-- STEP 5: 백업 실행 및 연동 -->
                                <StackPanel Visibility="{Binding EasyStep5Active, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="모든 백업 설정이 완벽하게 준비되었습니다!" Foreground="#f8fafc" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="원하시는 작업 방식을 선택하세요. 즉시 시작하거나, 자동 예약을 걸거나, 원클릭 실행 파일로 저장할 수 있습니다." Foreground="#94a3b8" FontSize="12" Margin="0,0,0,16"/>

                                    <StackPanel Margin="0,0,0,10">
                                        <!-- Action 1: 즉시 실행 -->
                                        <Border Background="#065f46" BorderBrush="#10b981" BorderThickness="2" CornerRadius="10" Margin="0,0,0,10">
                                            <Button Command="{Binding EasyWizardStartNowCommand}" Background="Transparent" BorderThickness="0" Padding="18,14" Cursor="Hand" HorizontalContentAlignment="Left">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="▶ 즉시 시작" Foreground="#34d399" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="🚀 지금 즉시 백업 시작 (실시간 진행 상황 보기)" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                        <TextBlock Text="라이브 러너 화면으로 즉시 전환되어 실시간 전송 속도와 진행 바를 확인하며 백업합니다." Foreground="#a7f3d0" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </Border>

                                        <!-- Action 2: 스케줄러 등록 -->
                                        <Border Background="#1e3a8a" BorderBrush="#3b82f6" BorderThickness="2" CornerRadius="10" Margin="0,0,0,10">
                                            <Button Command="{Binding EasyWizardScheduleNowCommand}" Background="Transparent" BorderThickness="0" Padding="18,14" Cursor="Hand" HorizontalContentAlignment="Left">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="📅 예약 등록" Foreground="#60a5fa" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="⏰ 매일/매주 자동 백업 스케줄러에 등록" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                        <TextBlock Text="지정한 시간마다 컴퓨터가 알아서 백업하도록 Windows 작업 스케줄러로 연동합니다." Foreground="#bfdbfe" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </Border>

                                        <!-- Action 3: 배치 파일 저장 -->
                                        <Border Background="#312e81" BorderBrush="#6366f1" BorderThickness="2" CornerRadius="10">
                                            <Button Command="{Binding EasyWizardExportBatCommand}" Background="Transparent" BorderThickness="0" Padding="18,14" Cursor="Hand" HorizontalContentAlignment="Left">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="💾 .bat 저장" Foreground="#a5b4fc" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="📄 바탕화면 원클릭 실행 파일(.bat)로 저장" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                        <TextBlock Text="프로그램을 켜지 않고도 더블 클릭 한 번으로 언제든 백업할 수 있는 배치 파일을 생성합니다." Foreground="#c7d2fe" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Wizard Footer Navigation Buttons -->
                    <DockPanel Grid.Row="3">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Command="{Binding EasyWizardPrevStepCommand}" Background="#334155" Foreground="#e2e8f0" Padding="16,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="◀ 이전 단계"/>
                            </Button>
                            <Button Command="{Binding CloseEasyWizardCommand}" Background="#475569" Foreground="#e2e8f0" Padding="14,8" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="취소"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Command="{Binding EasyWizardNextStepCommand}" Background="{Binding EasyWizardNextButtonBrush, FallbackValue='#059669'}" Foreground="White" FontWeight="Bold" Padding="20,8" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="{Binding EasyWizardNextButtonText, FallbackValue='다음 단계 ▶'}"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 5 Core DLL Wizard Modal Overlay (v2.9.0) -->
        <Grid Grid.RowSpan="3" Background="#cc000000" Visibility="{Binding IsCoreWizardOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="9998">
            <Border Background="#1e293b" BorderBrush="#3b82f6" BorderThickness="1.5" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Width="720" MaxHeight="680">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Wizard Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1d4ed8" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding WizardBadgeText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding WizardTitle}" Foreground="#f8fafc" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding WizardSubtitle}" Foreground="#94a3b8" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding CloseCoreDllWizardCommand}" Background="#334155" Foreground="#f8fafc" Padding="10,4" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" HorizontalAlignment="Right">
                            <TextBlock Text="✕ 닫기" FontWeight="Bold"/>
                        </Button>
                    </DockPanel>

                    <!-- 3-Step Wizard Indicator -->
                    <Border Grid.Row="1" Background="#0f172a" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#334155">
                        <UniformGrid Columns="3">
                            <Border Background="#1e3a8a" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                <TextBlock Text="1️⃣ 파라미터 &amp; 전략 구성" Foreground="#60a5fa" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                            <Border Background="#1e293b" CornerRadius="6" Padding="8,6" Margin="2,0,2,0">
                                <TextBlock Text="2️⃣ 사전 검증 &amp; 시뮬레이션" Foreground="#94a3b8" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                            <Border Background="#1e293b" CornerRadius="6" Padding="8,6" Margin="4,0,0,0">
                                <TextBlock Text="3️⃣ 메인 작업 반영 &amp; 완료" Foreground="#94a3b8" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                        </UniformGrid>
                    </Border>

                    <!-- Wizard Dynamic Content Area -->
                    <Border Grid.Row="2" Background="#0f172a" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#334155" MinHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Simulation Status & Log (Shared for all steps) -->
                                <Border Background="#1e293b" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="#3b82f6">
                                    <StackPanel>
                                        <TextBlock Text="💡 마법사 실시간 가이드 &amp; 사전 검증 결과" Foreground="#38bdf8" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding WizardSimResult}" Foreground="#e2e8f0" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="📝 단계별 상세 실행 로그" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ListBox ItemsSource="{Binding WizardLogs}" Height="130" Background="#020617" Foreground="#38bdf8" FontFamily="Consolas" FontSize="11" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,10"/>

                                <Button Command="{Binding WizardRunSimulationCommand}" Background="#0284c7" Foreground="White" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                                    <TextBlock Text="🧪 사전 시뮬레이션 즉시 다시 실행 (Simulation Pre-flight)"/>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Wizard Footer Action Buttons -->
                    <DockPanel Grid.Row="3">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Command="{Binding WizardPrevStepCommand}" Background="#334155" Foreground="#e2e8f0" Padding="16,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="◀ 이전 단계"/>
                            </Button>
                            <Button Command="{Binding CloseCoreDllWizardCommand}" Background="#475569" Foreground="#e2e8f0" Padding="14,8" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="취소"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Command="{Binding WizardNextStepCommand}" Background="#2563eb" Foreground="White" FontWeight="Bold" Padding="18,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="다음 단계 (Next) ▶"/>
                            </Button>
                            <Button Command="{Binding WizardApplyToMainJobCommand}" Background="#16a34a" Foreground="White" FontWeight="Bold" Padding="18,8" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="🚀 메인 백업 작업에 100% 즉시 반영"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- GitHub Releases Auto-Update Modal Overlay (v2.16.0) -->
        <Grid Grid.RowSpan="3" Background="#d9000000" Visibility="{Binding IsUpdateModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="9998">
            <Border Background="#0f172a" BorderBrush="#0284c7" BorderThickness="2" CornerRadius="16" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Width="680" MaxHeight="620">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0284c7" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="GitHub Releases" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="🚀 RoboBackup Studio 업데이트 센터" Foreground="#f8fafc" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="GitHub 실시간 릴리스 API를 통해 최신 배포 버전 및 릴리스 노트를 확인합니다." Foreground="#94a3b8" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding DismissUpdateModalCommand}" Background="#334155" Foreground="#f8fafc" Padding="12,5" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" HorizontalAlignment="Right">
                            <TextBlock Text="✕ 닫기" FontWeight="Bold"/>
                        </Button>
                    </DockPanel>

                    <!-- Version Status Banner -->
                    <Border Grid.Row="1" Background="#1e293b" CornerRadius="10" Padding="16,12" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#334155">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0f172a" CornerRadius="8" Padding="12,10" BorderThickness="1" BorderBrush="#334155">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="현재 실행 중인 버전" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentAppVersion, FallbackValue='v2.16.8'}" Foreground="#34d399" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Column="1" Text="➔" Foreground="#60a5fa" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0"/>

                            <Border Grid.Column="2" Background="#0f172a" CornerRadius="8" Padding="12,10" BorderThickness="1" BorderBrush="#0284c7">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="GitHub 최신 릴리스" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding LatestReleaseVersion, FallbackValue='v2.16.8'}" Foreground="#38bdf8" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Release Notes & Status Content -->
                    <Border Grid.Row="2" Background="#0f172a" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#334155" MinHeight="180">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="#1e293b" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" BorderThickness="1" BorderBrush="#334155">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📢 상태: " Foreground="#94a3b8" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding UpdateStatusMessage}" Foreground="#f8fafc" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="📝 릴리스 패치 내역 (Release Notes)" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding LatestReleaseNotes, Mode=OneWay}" Background="#020617" Foreground="#e2e8f0" BorderBrush="#334155" BorderThickness="1" Padding="12" FontSize="12" FontFamily="Consolas, Segoe UI" TextWrapping="Wrap" IsReadOnly="True" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Footer Action Buttons -->
                    <DockPanel Grid.Row="3">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Command="{Binding CheckUpdateCommand}" Background="#1e293b" Foreground="#38bdf8" BorderBrush="#0284c7" BorderThickness="1" Padding="14,8" Margin="0,0,8,0" Cursor="Hand" ToolTip="GitHub API를 다시 호출하여 최신 버전을 확인합니다">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄 다시 확인" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenUpdateUrlCommand}" Background="#334155" Foreground="#f8fafc" Padding="14,8" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐 GitHub 릴리스 보기" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Command="{Binding DismissUpdateModalCommand}" Background="#475569" Foreground="#e2e8f0" Padding="16,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="닫기"/>
                            </Button>
                            <Button Command="{Binding DownloadLatestUpdateCommand}" Background="#0284c7" Foreground="White" FontWeight="Bold" Padding="18,8" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬇️ 최신 버전 다운로드 (Setup.exe)"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Global Async Busy Overlay (Dimmer & Spinner for short modal tasks only) -->
        <Grid Grid.RowSpan="3" Background="#80000000" Visibility="{Binding BusyOverlayVisibility}" Panel.ZIndex="9999">
            <Border Background="#1e293b" BorderBrush="#3b82f6" BorderThickness="2" CornerRadius="12" Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Height="6" Width="280" Foreground="#38bdf8" Background="#0f172a" BorderThickness="0" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding BusyMessage}" Foreground="#f8fafc" FontSize="13" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="작업 완료 시까지 잠시만 기다려주세요..." Foreground="#94a3b8" FontSize="11" TextAlignment="Center" Margin="0,6,0,8"/>
                    <Button Command="{Binding DismissBusyOverlayCommand}" Content="✕ 닫기 (오버레이 해제)" HorizontalAlignment="Center" Background="#334155" Foreground="#e2e8f0" Padding="14,4" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
