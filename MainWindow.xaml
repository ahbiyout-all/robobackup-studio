                                        <DockPanel Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="📋 자동정리 스케줄러 등록 현황: " Foreground="#cbd5e1" FontSize="13" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CleanupTaskStatusSummary}" Foreground="#10b981" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                <Button Command="{Binding RefreshCleanupTaskStatusCommand}" Content="🔄 새로고침" Padding="10,4" Margin="0,0,6,0" Background="#334155" Foreground="#f8fafc" Cursor="Hand" FontSize="11" IsEnabled="{Binding IsNotBusy}"/>
