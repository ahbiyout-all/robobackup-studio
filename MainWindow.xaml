                                                        <DockPanel>
                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                <TextBlock Text="🔍 선택된 자동정리 상세 정보: " Foreground="#94a3b8" FontSize="11" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding SelectedRegisteredCleanupTask.TaskName}" Foreground="#34d399" FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SelectedRegisteredCleanupTask.NextRunTime, StringFormat='다음 실행: {0}'}" Foreground="#38bdf8" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                                        </DockPanel>
                                                    </Border>
                                                    <TextBox Text="{Binding CleanupTaskStatusDetails}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#a7f3d0" FontFamily="Consolas" FontSize="11" Padding="10" BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Cleanup Task Name Input -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="🏷️ 스케줄러 등록 이름 (Task Name)" Foreground="#cbd5e1" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
