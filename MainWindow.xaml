                                                <Button Command="{Binding DeleteCleanupTaskCommand}" Content="🗑️ 선택 스케줄 삭제" Padding="10,4" Background="#991b1b" Foreground="#ffffff" Cursor="Hand" FontSize="11" IsEnabled="{Binding IsNotBusy}"/>
