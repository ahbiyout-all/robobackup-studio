                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding CleanupTaskName, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="#fbbf24" FontFamily="Consolas" FontWeight="SemiBold" Padding="10,6" BorderThickness="1" BorderBrush="#334155" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="기본값: RoboBackupStudio_AutoCleanup (변경 가능)" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Freq -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
