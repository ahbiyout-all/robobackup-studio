<Window x:Class="RoboBackupStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RoboBackupStudio.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue='RoboBackup Studio v2.16.6 - High Performance Robocopy Studio'}" Height="880" Width="1160"
        Icon="robocopy.png"
        WindowStartupLocation="CenterScreen" Background="{Binding ThemeWindowBackground}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Theme-Aware TabControl Item Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{Binding ThemeCardBackground, FallbackValue='#1e293b'}"/>
            <Setter Property="Foreground" Value="{Binding ThemeTextSecondary, FallbackValue='#94a3b8'}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2563eb"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{Binding ThemeBorderBrush, FallbackValue='#334155'}"/>
                                <Setter Property="Foreground" Value="{Binding ThemeTextPrimary, FallbackValue='#f8fafc'}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Rounded Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Theme-Aware CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{Binding ThemeTextPrimary, FallbackValue='#f8fafc'}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,16,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- High-Contrast ComboBox Style (Dark Black Text on Light Box) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="Foreground" Value="#0f172a"/>
            <Setter Property="BorderBrush" Value="#64748b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- High-Contrast ComboBoxItem Style (Crisp Black Text in Dropdown) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="Foreground" Value="#0f172a"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563eb"/>
                    <Setter Property="Foreground" Value="#ffffff"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1d4ed8"/>
                    <Setter Property="Foreground" Value="#ffffff"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- High-Contrast DatePicker Style (Crisp Black Text) -->
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="Foreground" Value="#0f172a"/>
            <Setter Property="BorderBrush" Value="#64748b"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Navigation Bar -->
        <Border Grid.Row="0" Background="{Binding ThemeHeaderBackground}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{Binding ThemeBorderBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0f172a" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0" BorderBrush="#334155" BorderThickness="1" Padding="2" ClipToBounds="True">
                        <Image Source="robocopy.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RoboBackup" Foreground="{Binding ThemeHeaderForeground}" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock Text="Studio" Foreground="#60a5fa" FontSize="20" FontWeight="Bold" Margin="4,0,0,0"/>
                            <Border Background="#10b981" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersionBadgeText, FallbackValue='v2.16.6 (Dual)'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <!-- GitHub Update Check Button (v2.16.0) -->
                            <Button Command="{Binding CheckUpdateCommand}" Height="24" Padding="8,1" Margin="8,0,0,0" Background="#1e293b" Foreground="#38bdf8" BorderBrush="#0284c7" BorderThickness="1.2" VerticalAlignment="Center" Cursor="Hand" ToolTip="GitHub Releases 실시간 업데이트 확인">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔄 업데이트 확인" FontSize="11" FontWeight="SemiBold"/>
                                    <Ellipse Width="7" Height="7" Fill="#10b981" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding UpdateBadgeVisibility}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="초고속 파일 백업 &amp; 동기화 관리 시스템" Foreground="{Binding ThemeTextSecondary}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 4 Theme Selector Buttons [다크 / 회색 / 화이트 / 베이지] -->
                    <Border Background="{Binding ThemeInnerBackground}" CornerRadius="8" Padding="5,3" Margin="0,0,10,0" BorderThickness="1" BorderBrush="{Binding ThemeBorderBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎨" VerticalAlignment="Center" FontSize="11" Margin="2,0,6,0"/>

                            <!-- 1. 다크 -->
                            <Button Command="{Binding ChangeThemeCommand}" CommandParameter="dark" 
                                    Height="25" Padding="7,0" Margin="0,0,3,0"
                                    Background="{Binding ThemeDarkButtonBg}" Foreground="{Binding ThemeDarkButtonFg}" 
                                    BorderBrush="{Binding ThemeDarkButtonBorder}" BorderThickness="1" 
                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand" ToolTip="다크 (Dark) 테마 적용">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌙 " FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="다크" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. 회색 -->
                            <Button Command="{Binding ChangeThemeCommand}" CommandParameter="grey" 
                                    Height="25" Padding="7,0" Margin="0,0,3,0"
                                    Background="{Binding ThemeGrayButtonBg}" Foreground="{Binding ThemeGrayButtonFg}" 
                                    BorderBrush="{Binding ThemeGrayButtonBorder}" BorderThickness="1" 
                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand" ToolTip="회색 (Cool Grey) 테마 적용">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌫️ " FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="회색" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. 화이트 -->
                            <Button Command="{Binding ChangeThemeCommand}" CommandParameter="white" 
                                    Height="25" Padding="7,0" Margin="0,0,3,0"
                                    Background="{Binding ThemeWhiteButtonBg}" Foreground="{Binding ThemeWhiteButtonFg}" 
                                    BorderBrush="{Binding ThemeWhiteButtonBorder}" BorderThickness="1" 
                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand" ToolTip="화이트 (Clean White) 테마 적용">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="☀️ " FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="화이트" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 4. 베이지 -->
                            <Button Command="{Binding ChangeThemeCommand}" CommandParameter="beige" 
                                    Height="25" Padding="7,0" Margin="0,0,2,0"
                                    Background="{Binding ThemeBeigeButtonBg}" Foreground="{Binding ThemeBeigeButtonFg}" 
                                    BorderBrush="{Binding ThemeBeigeButtonBorder}" BorderThickness="1" 
                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand" ToolTip="베이지 (Warm Beige) 테마 적용">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌾 " FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="베이지" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Easy Backup Wizard (v2.12.0) -->
                    <Button Command="{Binding OpenEasyWizardCommand}" Height="30" Padding="10,2" Margin="0,0,10,0" Background="#065f46" Foreground="#a7f3d0" BorderBrush="#10b981" BorderThickness="1.5" Cursor="Hand" ToolTip="어려운 옵션 없이 5단계로 백업을 설정하는 초보자 마법사">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧙‍♂️ 초보자 마법사" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Admin Status Badge & Restart Button -->
                    <Button Command="{Binding RestartAsAdminCommand}" Height="30" Padding="10,2" Margin="0,0,10,0" Background="#1e1b4b" Foreground="#a5b4fc" BorderBrush="#6366f1" BorderThickness="1" Cursor="Hand" ToolTip="UAC 관리자 권한으로 앱을 다시 시작합니다">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AdminStatusText}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Border Background="#0f172a" CornerRadius="8" Padding="12,6" BorderThickness="1" BorderBrush="#334155">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="상태: " Foreground="#94a3b8" FontSize="12"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="#38bdf8" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Tab Workspace -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            
            <!-- TAB 1: 작업 설계기 (Job Designer) -->
            <TabItem Header="🎯 백업 프로필 설계">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,0">
                        
                        <!-- Presets Bar with Advanced Combinations Toggle -->
                        <Border Background="{Binding ThemeCardBackground}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{Binding ThemeBorderBrush}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🚀 초고속 백업 프리셋 선택" Foreground="{Binding ThemeCardHeaderForeground}" FontSize="14" FontWeight="Bold"/>
                                        <Border Background="#3b82f6" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="기본 4대" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Command="{Binding OpenEasyWizardCommand}" Background="#065f46" Foreground="#ecfdf5" BorderBrush="#10b981" BorderThickness="1.5" Padding="12,4" Margin="0,0,8,0" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="5단계 안심 가이드로 초보자도 쉽게 백업 구성">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🧙‍♂️ 초보자 안심 마법사" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ToggleAdvancedPresetsCommand}" Content="{Binding AdvancedPresetsToggleText}" Background="#312e81" Foreground="#c7d2fe" BorderBrush="#6366f1" BorderThickness="1" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Standard Quick Presets -->
                                <UniformGrid Columns="4" Margin="0,0,0,8">
                                    <Button Command="{Binding ApplyPresetCommand}" CommandParameter="high_speed_mirror" Height="48" Margin="0,0,8,0" Background="{Binding PresetHighSpeedMirrorBackground}" Foreground="{Binding PresetHighSpeedMirrorForeground}" BorderBrush="{Binding PresetHighSpeedMirrorBorder}" BorderThickness="2" Cursor="Hand">
                                        <TextBlock Text="⚡ 초고속 미러링&#10;(/MIR /MT:16 /ZB)" TextAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Command="{Binding ApplyPresetCommand}" CommandParameter="incremental" Height="48" Margin="0,0,8,0" Background="{Binding PresetIncrementalBackground}" Foreground="{Binding PresetIncrementalForeground}" BorderBrush="{Binding PresetIncrementalBorder}" BorderThickness="2" Cursor="Hand">
                                        <TextBlock Text="📦 증분 차등 백업&#10;(/E /XO /XC)" TextAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Command="{Binding ApplyPresetCommand}" CommandParameter="lan_nas" Height="48" Margin="0,0,8,0" Background="{Binding PresetLanNasBackground}" Foreground="{Binding PresetLanNasForeground}" BorderBrush="{Binding PresetLanNasBorder}" BorderThickness="2" Cursor="Hand">
                                        <TextBlock Text="🌐 LAN / NAS 네트워크&#10;(/MIR /ZB /FFT)" TextAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Command="{Binding ApplyPresetCommand}" CommandParameter="safe_test" Height="48" Background="{Binding PresetSafeTestBackground}" Foreground="{Binding PresetSafeTestForeground}" BorderBrush="{Binding PresetSafeTestBorder}" BorderThickness="2" Cursor="Hand">
                                        <TextBlock Text="🛡️ 안전 백업 테스트&#10;(/L /NP 시뮬레이션)" TextAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                </UniformGrid>

                                <!-- Advanced Master Combinations (Collapsible Section) -->
                                <Border Visibility="{Binding IsAdvancedPresetsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{Binding ThemeInnerBackground}" CornerRadius="8" Padding="12" Margin="0,4,0,0" BorderThickness="1" BorderBrush="{Binding ThemeBorderBrush}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="✨ 5대 엔터프라이즈 마스터 프리셋 (원클릭 최적 조합)" Foreground="{Binding ThemeAccentBrush}" FontSize="12" FontWeight="Bold"/>
                                                <Border Background="#4c1d95" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="전문가 추천" Foreground="#d8b4fe" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right" Command="{Binding ResetAdvancedFlagsCommand}" Content="↺ 고급옵션 초기화" Padding="8,2" Background="#334155" Foreground="#f8fafc" FontSize="11" Cursor="Hand" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <WrapPanel>
                                            <Button Command="{Binding ApplyAdvancedMasterPresetCommand}" CommandParameter="server_migration" Margin="0,0,8,6" Padding="10,6" Background="{Binding MasterServerMigrationBackground}" Foreground="#c084fc" BorderBrush="{Binding MasterServerMigrationBorder}" BorderThickness="1.5" Cursor="Hand">
                                                <TextBlock Text="🏢 서버 마이그레이션 (/COPYALL /ZB /XJ /FFT)" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Command="{Binding ApplyAdvancedMasterPresetCommand}" CommandParameter="nvme_speed" Margin="0,0,8,6" Padding="10,6" Background="{Binding MasterNvmeSpeedBackground}" Foreground="#6ee7b7" BorderBrush="{Binding MasterNvmeSpeedBorder}" BorderThickness="1.5" Cursor="Hand">
                                                <TextBlock Text="🚀 NVMe 초고속 (/MT:32 /NP /IPG:0)" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Command="{Binding ApplyAdvancedMasterPresetCommand}" CommandParameter="nas_safe" Margin="0,0,8,6" Padding="10,6" Background="{Binding MasterNasSafeBackground}" Foreground="#93c5fd" BorderBrush="{Binding MasterNasSafeBorder}" BorderThickness="1.5" Cursor="Hand">
                                                <TextBlock Text="🛡️ NAS 안정 동기화 (/FFT /ZB /R:2 /W:3)" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Command="{Binding ApplyAdvancedMasterPresetCommand}" CommandParameter="bandwidth_throttle" Margin="0,0,8,6" Padding="10,6" Background="{Binding MasterBandwidthThrottleBackground}" Foreground="#fde68a" BorderBrush="{Binding MasterBandwidthThrottleBorder}" BorderThickness="1.5" Cursor="Hand">
                                                <TextBlock Text="📉 네트워크 대역폭 분산 (/IPG:50 /MT:4)" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Command="{Binding ApplyAdvancedMasterPresetCommand}" CommandParameter="night_window" Margin="0,0,8,6" Padding="10,6" Background="{Binding MasterNightWindowBackground}" Foreground="#c7d2fe" BorderBrush="{Binding MasterNightWindowBorder}" BorderThickness="1.5" Cursor="Hand">
                                                <TextBlock Text="🌙 야간 백업 창 (/RH:2200-0600 /PF)" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Paths Card -->
                        <Border Background="{Binding ThemeCardBackground}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{Binding ThemeBorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Source -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📁 원본 폴더 경로 (Source Path)" Foreground="{Binding ThemeCardHeaderForeground}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="찾아보기..." Command="{Binding BrowseSourceCommand}" Width="80" Height="36" Margin="8,0,0,0" Background="#334155" Foreground="White" BorderThickness="0"/>
                                        <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Background="{Binding ThemeInputBackground}" Foreground="{Binding ThemeInputForeground}" Padding="10,8" BorderThickness="1" BorderBrush="{Binding ThemeInputBorder}" FontSize="13" VerticalContentAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- Swap Button -->
                                <Button Grid.Column="1" Command="{Binding SwapPathsCommand}" Width="40" Height="36" Margin="12,20,12,0" Background="#334155" Foreground="#60a5fa" FontSize="16" FontWeight="Bold" Content="⇄" BorderThickness="0" ToolTip="원본과 대상 경로 반전"/>

                                <!-- Destination -->
                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="💾 대상 폴더 경로 (Destination Path)" Foreground="{Binding ThemeCardHeaderForeground}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Command="{Binding ApplyNasPathCommand}" Content="🌐 NAS 주소 적용" ToolTip="설정된 NAS 공유 경로(\\IP\Share)를 백업 대상 폴더로 자동 설정" HorizontalAlignment="Right" Padding="8,2" Background="#1e1b4b" Foreground="#a7f3d0" BorderBrush="#4338ca" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="찾아보기..." Command="{Binding BrowseDestinationCommand}" Width="75" Height="36" Margin="6,0,0,0" Background="#334155" Foreground="White" BorderThickness="0"/>
                                        <Button DockPanel.Dock="Right" Content="🌐 NAS 폴더 선택..." Command="{Binding OpenNasFolderCommand}" ToolTip="NAS 네트워크 주소(\IP\Share) 내의 백업 대상 폴더를 찾아보고 선택" Height="36" Padding="8,0" Margin="6,0,0,0" Background="#4338ca" Foreground="#a7f3d0" BorderThickness="0" FontWeight="Bold" FontSize="11" Cursor="Hand"/>
                                        <TextBox x:Name="DestinationPathTextBox" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" LostFocus="DestinationTextBox_LostFocus" Background="{Binding ThemeInputBackground}" Foreground="{Binding ThemeInputForeground}" Padding="10,8" BorderThickness="1" BorderBrush="{Binding ThemeInputBorder}" FontSize="13" VerticalContentAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- NAS Network Credentials Expander (Collapsible) -->
                        <Border Background="#1e1b4b" CornerRadius="12" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#4338ca">
                            <Expander IsExpanded="{Binding IsNasExpanderOpen, FallbackValue=False}" Background="Transparent" Foreground="#e0e7ff" Padding="12" BorderThickness="0">
                                <Expander.Header>
                                    <DockPanel Width="820">
                                         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔑 NAS / 네트워크 자격 증명 (접이식 설정)" Foreground="#e0e7ff" FontSize="13" FontWeight="Bold"/>
                                            <Border Background="#312e81" CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding NasDetectionBadgeText}" Foreground="#a5b4fc" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Expander.Header>

                                <StackPanel Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- NAS Host/IP -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                            <TextBlock Text="🌐 NAS 서버 IP / 호스트명" Foreground="#c7d2fe" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding NasServerAddress, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="#f8fafc" Padding="8" BorderThickness="1" BorderBrush="#4338ca" FontSize="12" IsEnabled="{Binding IsNotNasBusy}" ToolTip="NAS의 IP 주소 또는 네트워크 호스트명을 입력합니다. (예: 192.168.0.200)"/>
                                        </StackPanel>

                                        <!-- NAS Share Path -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                            <TextBlock Text="📁 NAS 전체 UNC 공유 경로 (자동 연동)" Foreground="#c7d2fe" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding NasSharePath, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="#f8fafc" Padding="8" BorderThickness="1" BorderBrush="#4338ca" FontSize="12" IsEnabled="{Binding IsNotNasBusy}" ToolTip="net use 세션 및 Robocopy가 연결할 전체 UNC 경로입니다. (예: \\192.168.0.200)"/>
                                        </StackPanel>

                                        <!-- Username -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="👤 NAS 사용자 아이디 (Username)" Foreground="#c7d2fe" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding NasUsername, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="#f8fafc" Padding="8" BorderThickness="1" BorderBrush="#4338ca" FontSize="12" IsEnabled="{Binding IsNotNasBusy}"/>
                                        </StackPanel>

                                        <!-- Password -->
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="🔒 비밀번호 (Password)" Foreground="#c7d2fe" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding NasPassword, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="#f8fafc" Padding="8" BorderThickness="1" BorderBrush="#4338ca" FontSize="12" IsEnabled="{Binding IsNotNasBusy}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Duplicate / Conflict Warning Banner (v2.3.9) -->
                                    <Border Background="#451a03" BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                                            Visibility="{Binding DuplicateConflictVisibility}">
                                        <DockPanel>
                                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DuplicateNasConflictMessage}" Foreground="#fef3c7" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Auth Method Selection & Action Buttons -->
                                    <DockPanel Margin="0,0,0,8">
                                        <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <Button Command="{Binding SaveNasCredentialCommand}" Content="🔑 cmdkey 자격 증명 등록" Background="#16a34a" Foreground="White" BorderThickness="0" Padding="12,6" Margin="0,0,8,0" FontWeight="Bold" FontSize="11" Cursor="Hand" ToolTip="스케줄러 무인 백업 시에도 Windows가 안전하게 암호화 보관하여 자동 인증합니다." IsEnabled="{Binding IsNotNasBusy}"/>
                                            <Button Command="{Binding DeleteNasCredentialCommand}" Content="🗑️ 자격 증명 삭제" Background="#334155" Foreground="#f87171" BorderThickness="0" Padding="10,6" Margin="0,0,8,0" FontSize="11" Cursor="Hand" IsEnabled="{Binding IsNotNasBusy}"/>
                                            <Button Command="{Binding ConnectNetUseCommand}" Content="🔗 net use 연결" Background="#0284c7" Foreground="White" BorderThickness="0" Padding="12,6" Margin="0,0,8,0" FontWeight="Bold" FontSize="11" Cursor="Hand" IsEnabled="{Binding IsNotNasBusy}"/>
                                            <Button Command="{Binding DisconnectNetUseCommand}" Content="🔌 net use 해제" Background="#334155" Foreground="#fdba74" BorderThickness="0" Padding="10,6" Margin="0,0,8,0" FontSize="11" Cursor="Hand" IsEnabled="{Binding IsNotNasBusy}"/>
                                            <Button Command="{Binding TestNasConnectionCommand}" Content="📡 연결 진단" Background="#4f46e5" Foreground="White" BorderThickness="0" Padding="12,6" Margin="0,0,8,0" FontWeight="Bold" FontSize="11" Cursor="Hand" IsEnabled="{Binding IsNotNasBusy}"/>
                                            <Button Command="{Binding ApplyNasOptimalFlagsCommand}" Content="⚡ NAS 최적 옵션 (/FFT /ZB)" Background="#3730a3" Foreground="#fde047" BorderThickness="0" Padding="10,6" Margin="0,0,8,0" FontWeight="Bold" FontSize="11" Cursor="Hand" IsEnabled="{Binding IsNotNasBusy}"/>
                                        </WrapPanel>
                                        <Button DockPanel.Dock="Right" Command="{Binding CopyNasBatchScriptCommand}" Content="📋 NAS 배치 스크립트 (.bat) 복사" Background="#1e1b4b" Foreground="#a5b4fc" BorderBrush="#6366f1" BorderThickness="1" Padding="10,6" FontSize="11" Cursor="Hand" HorizontalAlignment="Right" IsEnabled="{Binding IsNotNasBusy}"/>
                                    </DockPanel>

                                    <!-- Registered Credentials & Active Sessions Section (Duplicate Prevention) -->
                                    <Border Background="#0f172a" CornerRadius="8" Padding="12" Margin="0,4,0,8" BorderThickness="1" BorderBrush="#334155">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📋 현재 시스템에 등록된 자격 증명 &amp; 활성 SMB 세션" Foreground="#e2e8f0" FontSize="12" FontWeight="Bold"/>
                                                    <Border Background="#1e293b" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding SavedCredentialsCount, StringFormat='총 {0}개 감지'}" Foreground="#94a3b8" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <Button DockPanel.Dock="Right" Command="{Binding RefreshNasCredentialsCommand}" Content="🔄 목록 새로고침" Background="#334155" Foreground="#38bdf8" BorderThickness="0" Padding="8,3" FontSize="10" Cursor="Hand" HorizontalAlignment="Right" IsEnabled="{Binding IsNotNasBusy}"/>
                                            </DockPanel>

                                            <!-- Scanning Indicator -->
                                            <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,6" Foreground="#38bdf8" Background="#1e293b" BorderThickness="0" Visibility="{Binding ScanningCredentialsVisibility}"/>

                                            <!-- Empty State -->
                                            <TextBlock Text="현재 Windows에 저장된 NAS 자격 증명이나 활성 세션이 없습니다. (깨끗한 상태)" Foreground="#64748b" FontSize="11" FontStyle="Italic" Margin="4,4,0,4"
                                                       Visibility="{Binding NoCredentialsVisibility}"/>

                                            <!-- Credentials / Sessions List -->
                                            <ItemsControl ItemsSource="{Binding SavedNasCredentials}" Visibility="{Binding SavedCredentialsVisibility}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding MatchedBackground}" BorderBrush="{Binding MatchedBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                            <DockPanel>
                                                                <!-- Badges & Target Info -->
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                                    <Border Background="{Binding TypeBadgeBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding TypeBadgeText}" Foreground="{Binding TypeBadgeForeground}" FontSize="10" FontWeight="Bold"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Target}" Foreground="#f8fafc" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="• 계정: " Foreground="#64748b" FontSize="10" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Username}" Foreground="#cbd5e1" FontSize="10" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Status}" Foreground="#94a3b8" FontSize="10" VerticalAlignment="Center"/>
                                                                </StackPanel>

                                                                <!-- Actions -->
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                                    <Button Command="{Binding DataContext.LoadNasCredentialItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                            Content="📥 입력창에 적용" Background="#1e293b" Foreground="#38bdf8" BorderBrush="#0284c7" BorderThickness="1" Padding="6,2" FontSize="10" Margin="0,0,6,0" Cursor="Hand"/>
                                                                    <Button Command="{Binding DataContext.DeleteSpecificCredentialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                            Content="🗑️ 삭제/해제" Background="#1e293b" Foreground="#f87171" BorderBrush="#ef4444" BorderThickness="1" Padding="6,2" FontSize="10" Cursor="Hand"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Status bar & Busy Progress -->
                                    <Border Background="#0f172a" CornerRadius="8" Padding="10,6" Margin="0,4,0,0" BorderThickness="1" BorderBrush="#312e81">
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="0,0,8,0" Foreground="#818cf8" Background="#1e1b4b" BorderThickness="0" Visibility="{Binding NasBusyProgressVisibility}"/>
                                                <TextBlock Text="💡 상태: " Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding NasStatusMessage}" Foreground="#818cf8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding NasConnectionBadgeText}" Foreground="#34d399" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Robocopy Core Flags Configuration + Collapsible Advanced Options -->
                        <Border Background="{Binding ThemeCardBackground}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{Binding ThemeBorderBrush}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="⚙️ Robocopy 핵심 옵션 및 스레드 설정" Foreground="{Binding ThemeCardHeaderForeground}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Command="{Binding ToggleAdvancedFlagsCommand}" Content="{Binding AdvancedFlagsToggleText}" Background="#4c1d95" Foreground="#f3e8ff" BorderBrush="#8b5cf6" BorderThickness="1" Padding="12,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Right"/>
                                </DockPanel>
                                
                                <WrapPanel Margin="0,0,0,10">
                                    <CheckBox Content="/MIR (디렉토리 트리 완벽 미러링)" IsChecked="{Binding IsMir}"/>
                                    <CheckBox Content="/MT:16 (16스레드 다중 병렬 복사)" IsChecked="{Binding IsMt16}"/>
                                    <CheckBox Content="/ZB (재시도 모드 - 권한 실패 복구)" IsChecked="{Binding IsZb}"/>
                                    <CheckBox Content="/FFT (FAT 파일시스템 2초 시간오차 허용)" IsChecked="{Binding IsFft}"/>
                                    <CheckBox Content="/XO (기존 파일 제외 - 변경된 파일만 복사)" IsChecked="{Binding IsXo}"/>
                                    <CheckBox Content="/NP (진행률 퍼센트 표시 안 함 - 속도 극대화)" IsChecked="{Binding IsNp}"/>
                                    <CheckBox Content="🛡️ Auto VSS (열린 파일/DB 섀도 스냅샷 자동 생성)" IsChecked="{Binding IsServiceAutoVssEnabled}" Foreground="#38bdf8" FontWeight="SemiBold" ToolTip="백업 시작 전 볼륨 섀도 복사본(VSS)을 생성하여 Excel, Word, Outlook PST, SQL Server MDF 등 사용 중인 파일의 잠금 에러를 100% 방지하고 완료 후 자동 환수합니다."/>
                                </WrapPanel>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Exclude Files -->
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="🚫 제외할 파일 패턴 (/XF)" Foreground="{Binding ThemeCardHeaderForeground}" FontSize="12" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                            <Button Command="{Binding ResetDefaultExclusionsCommand}" Content="기본값 복원" Background="Transparent" Foreground="#60a5fa" BorderThickness="0" FontSize="11" DockPanel.Dock="Right" Cursor="Hand" ToolTip="기본 추천 패턴으로 복원"/>
                                        </DockPanel>
                                        <TextBox Text="{Binding ExcludedFiles, UpdateSourceTrigger=PropertyChanged}" Background="{Binding ThemeInputBackground}" Foreground="{Binding ThemeInputForeground}" Padding="8" BorderThickness="1" BorderBrush="{Binding ThemeInputBorder}" Margin="0,0,0,6"/>
                                        <TextBlock Text="💡 빠른 원클릭 추가/제거 프리셋:" Foreground="{Binding ThemeTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                        <WrapPanel>
                                            <Button Command="{Binding TogglePresetFilePatternCommand}" CommandParameter="*.tmp" Content="+ *.tmp" Margin="0,0,4,4" Padding="6,2" Background="#0f172a" Foreground="#93c5fd" BorderBrush="#1d4ed8" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                            <Button Command="{Binding TogglePresetFilePatternCommand}" CommandParameter="thumbs.db" Content="+ thumbs.db" Margin="0,0,4,4" Padding="6,2" Background="#0f172a" Foreground="#93c5fd" BorderBrush="#1d4ed8" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                            <Button Command="{Binding TogglePresetFilePatternCommand}" CommandParameter="desktop.ini" Content="+ desktop.ini" Margin="0,0,4,4" Padding="6,2" Background="#0f172a" Foreground="#93c5fd" BorderBrush="#1d4ed8" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                            <Button Command="{Binding TogglePresetFilePatternCommand}" CommandParameter="*.bak" Content="+ *.bak" Margin="0,0,4,4" Padding="6,2" Background="#0f172a" Foreground="#93c5fd" BorderBrush="#1d4ed8" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                            <Button Command="{Binding TogglePresetFilePatternCommand}" CommandParameter="*.log" Content="+ *.log" Margin="0,0,4,4" Padding="6,2" Background="#0f172a" Foreground="#93c5fd" BorderBrush="#1d4ed8" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                            <Button Command="{Binding TogglePresetFilePatternCommand}" CommandParameter="~$*" Content="+ ~$*" Margin="0,0,4,4" Padding="6,2" Background="#0f172a" Foreground="#93c5fd" BorderBrush="#1d4ed8" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Exclude Dirs -->
                                    <StackPanel Grid.Column="1">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="🚫 제외할 디렉토리 패턴 (/XD)" Foreground="{Binding ThemeCardHeaderForeground}" FontSize="12" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                            <Button Command="{Binding ClearExclusionsCommand}" Content="전체 지우기" Background="Transparent" Foreground="#f87171" BorderThickness="0" FontSize="11" DockPanel.Dock="Right" Cursor="Hand" ToolTip="모든 제외 패턴 초기화"/>
                                        </DockPanel>
                                        <TextBox Text="{Binding ExcludedDirs, UpdateSourceTrigger=PropertyChanged}" Background="{Binding ThemeInputBackground}" Foreground="{Binding ThemeInputForeground}" Padding="8" BorderThickness="1" BorderBrush="{Binding ThemeInputBorder}" Margin="0,0,0,6"/>
                                        <TextBlock Text="💡 빠른 원클릭 추가/제거 프리셋:" Foreground="{Binding ThemeTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                        <WrapPanel>
                                            <Button Command="{Binding TogglePresetDirPatternCommand}" CommandParameter="$RECYCLE.BIN" Content="+ $RECYCLE.BIN" Margin="0,0,4,4" Padding="6,2" Background="#0f172a" Foreground="#6ee7b7" BorderBrush="#047857" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                            <Button Command="{Binding TogglePresetDirPatternCommand}" CommandParameter="System Volume Information" Content="+ System Volume Information" Margin="0,0,4,4" Padding="6,2" Background="#0f172a" Foreground="#6ee7b7" BorderBrush="#047857" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                            <Button Command="{Binding TogglePresetDirPatternCommand}" CommandParameter="node_modules" Content="+ node_modules" Margin="0,0,4,4" Padding="6,2" Background="#0f172a" Foreground="#6ee7b7" BorderBrush="#047857" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                            <Button Command="{Binding TogglePresetDirPatternCommand}" CommandParameter=".git" Content="+ .git" Margin="0,0,4,4" Padding="6,2" Background="#0f172a" Foreground="#6ee7b7" BorderBrush="#047857" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                            <Button Command="{Binding TogglePresetDirPatternCommand}" CommandParameter="Temp" Content="+ Temp" Margin="0,0,4,4" Padding="6,2" Background="#0f172a" Foreground="#6ee7b7" BorderBrush="#047857" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                            <Button Command="{Binding TogglePresetDirPatternCommand}" CommandParameter="Cache" Content="+ Cache" Margin="0,0,4,4" Padding="6,2" Background="#0f172a" Foreground="#6ee7b7" BorderBrush="#047857" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Collapsible Robocopy Enterprise Advanced Flags Section (Placed Directly Under Core Options) -->
                                <Border Visibility="{Binding IsAdvancedFlagsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#0f172a" CornerRadius="10" Padding="14" Margin="0,14,0,0" BorderThickness="1" BorderBrush="#581c87">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚡ Robocopy 세부 고급 플래그 설정 허브" Foreground="#f3e8ff" FontSize="13" FontWeight="Bold"/>
                                                <Border Background="#4c1d95" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="ACL · 필터 · 대역폭 · 시간대" Foreground="#d8b4fe" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="필요한 옵션을 체크하면 명령줄에 자동 조합됩니다" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- Category 1: 보안 & 권한 모드 -->
                                        <Border Background="#1e1b4b" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#334155">
                                            <StackPanel>
                                                <TextBlock Text="🛡️ 1. 보안, 권한 및 특수 모드 (Security &amp; Metadata)" Foreground="#c084fc" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <WrapPanel>
                                                    <CheckBox Content="/COPYALL (모든 메타데이터 및 NTFS ACL 권한 복제)" IsChecked="{Binding IsCopyAll, FallbackValue=False}" ToolTip="/COPY:DATSOU 와 동일" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/SEC (NTFS 보안 권한 복사)" IsChecked="{Binding IsCopySec, FallbackValue=False}" ToolTip="/COPY:DATS 와 동일" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/SECFIX (파일 복사 없이 보안 권한만 새로고침)" IsChecked="{Binding IsSecFix, FallbackValue=False}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/TIMFIX (파일 복사 없이 타임스탬프만 일치화)" IsChecked="{Binding IsTimFix, FallbackValue=False}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/NOOFFLOAD (Windows ODX 하드웨어 오프로드 끄기)" IsChecked="{Binding IsNoOffload, FallbackValue=False}" Margin="0,0,16,6"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Category 2: 성능 & 대역폭 제어 -->
                                        <Border Background="#1e1b4b" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#334155">
                                            <StackPanel>
                                                <TextBlock Text="⚡ 2. 성능 및 I/O 대역폭 제어 (Performance &amp; Throttling)" Foreground="#60a5fa" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <TextBlock Text="멀티스레드 복사 (/MT:n)" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,4"/>
                                                        <ComboBox SelectedValue="{Binding Threads, Mode=TwoWay}" SelectedValuePath="Tag" Height="32">
                                                            <ComboBoxItem Content="1 스레드 (/MT:1 - 순차 복사)" Tag="1"/>
                                                            <ComboBoxItem Content="4 스레드 (/MT:4 - 안정)" Tag="4"/>
                                                            <ComboBoxItem Content="8 스레드 (/MT:8 - 표준)" Tag="8"/>
                                                            <ComboBoxItem Content="16 스레드 (/MT:16 - 고속 추천)" Tag="16" IsSelected="True"/>
                                                            <ComboBoxItem Content="32 스레드 (/MT:32 - SSD/NVMe)" Tag="32"/>
                                                            <ComboBoxItem Content="64 스레드 (/MT:64 - 고성능 서버)" Tag="64"/>
                                                            <ComboBoxItem Content="128 스레드 (/MT:128 - 최대치)" Tag="128"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="패킷 간 지연 밀리초 (/IPG:n)" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,4"/>
                                                        <ComboBox SelectedValue="{Binding Ipg, Mode=TwoWay}" SelectedValuePath="Tag" Height="32">
                                                            <ComboBoxItem Content="0 ms (/IPG:0 - 최고 속도)" Tag="0" IsSelected="True"/>
                                                            <ComboBoxItem Content="10 ms (/IPG:10 - 미세 조절)" Tag="10"/>
                                                            <ComboBoxItem Content="20 ms (/IPG:20 - 약한 분산)" Tag="20"/>
                                                            <ComboBoxItem Content="50 ms (/IPG:50 - 표준 분산)" Tag="50"/>
                                                            <ComboBoxItem Content="100 ms (/IPG:100 - 대역폭 절약)" Tag="100"/>
                                                            <ComboBoxItem Content="200 ms (/IPG:200 - 저속 회선)" Tag="200"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                                <WrapPanel>
                                                    <CheckBox Content="/XJ (Junction 포인트 제외 - 무한루프 차단)" IsChecked="{Binding IsExcludeJunctions, FallbackValue=True}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/SL (심볼릭 링크 대상 자체 복사)" IsChecked="{Binding IsCopySymlink, FallbackValue=False}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/SJ (Junction 디렉터리 링크 자체 복사)" IsChecked="{Binding IsCopyJunction, FallbackValue=False}" Margin="0,0,16,6"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Category 3: 정밀 필터링 & 파일 크기/연령 -->
                                        <Border Background="#1e1b4b" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#334155">
                                            <StackPanel>
                                                <TextBlock Text="🎯 3. 정밀 필터링 및 조건부 복사 (Advanced Filtering)" Foreground="#34d399" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <WrapPanel Margin="0,0,0,8">
                                                    <CheckBox Content="/XO (대상에 더 최신 파일이 있으면 덮어쓰기 제외)" IsChecked="{Binding IsXo}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/XN (최신 파일 복사 제외)" IsChecked="{Binding IsExcludeNewer, FallbackValue=False}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/XC (수정된 파일 제외)" IsChecked="{Binding IsExcludeChanged, FallbackValue=False}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/XU (동일한 파일 제외)" IsChecked="{Binding IsExcludeSame, FallbackValue=False}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/XX (대상에만 있는 여분 파일 복사 제외)" IsChecked="{Binding IsExcludeExtra, FallbackValue=False}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/XL (원본에만 있는 외톨이 파일 복사 제외)" IsChecked="{Binding IsExcludeLonely, FallbackValue=False}" Margin="0,0,16,6"/>
                                                </WrapPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                        <TextBlock Text="최소 크기 MB (/MIN)" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding MinFileSizeMb, UpdateSourceTrigger=PropertyChanged}" Background="#020617" Foreground="#38bdf8" Padding="6" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                        <TextBlock Text="최대 크기 MB (/MAX)" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding MaxFileSizeMb, UpdateSourceTrigger=PropertyChanged}" Background="#020617" Foreground="#38bdf8" Padding="6" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                                        <TextBlock Text="최소 연령 일 (/MINAGE)" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding MinFileAgeDays, UpdateSourceTrigger=PropertyChanged}" Background="#020617" Foreground="#38bdf8" Padding="6" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="최대 연령 일 (/MAXAGE)" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding MaxFileAgeDays, UpdateSourceTrigger=PropertyChanged}" Background="#020617" Foreground="#38bdf8" Padding="6" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Category 4: 실시간 감시 & 허용 시간대 -->
                                        <Border Background="#1e1b4b" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#334155">
                                            <StackPanel>
                                                <TextBlock Text="🔄 4. 실시간 감시 및 허용 시간대 (Sync &amp; Run Hours)" Foreground="#fde047" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                        <TextBlock Text="변경 감지 파일수 (/MON:n)" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding MonitorCount, UpdateSourceTrigger=PropertyChanged}" Background="#020617" Foreground="#fde047" Padding="6" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                        <TextBlock Text="수정 대기시간 분 (/MOT:m)" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding MonitorMinutes, UpdateSourceTrigger=PropertyChanged}" Background="#020617" Foreground="#fde047" Padding="6" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="실행 허용시간 (/RH:hhmm-hhmm)" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding RunHoursWindow, UpdateSourceTrigger=PropertyChanged}" Background="#020617" Foreground="#fde047" Padding="6" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                                <WrapPanel>
                                                    <CheckBox Content="/PF (허용 시간대 종료 시 파일 단위 안전 완료)" IsChecked="{Binding IsPerFileTimeCheck, FallbackValue=False}" Margin="0,0,16,6"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Category 5: NAS 호환성 & 로깅 -->
                                        <Border Background="#1e1b4b" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#334155">
                                            <StackPanel>
                                                <TextBlock Text="💾 5. NAS 호환성 및 출력 로깅 (NAS &amp; Logging)" Foreground="#38bdf8" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <WrapPanel>
                                                    <CheckBox Content="/FFT (FAT 시간 2초 오차 허용 - NAS 권장)" IsChecked="{Binding IsFft}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/FAT (8.3 짧은 파일명만 생성)" IsChecked="{Binding IsFatNames, FallbackValue=False}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/NP (진행률 퍼센트 화면 출력 억제 - 고속화)" IsChecked="{Binding IsNp}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/TS (로그에 파일 타임스탬프 포함)" IsChecked="{Binding IsIncludeTimestamps, FallbackValue=True}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/FP (로그에 전체 파일 경로 표시)" IsChecked="{Binding IsFullPathNames, FallbackValue=True}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="/BYTES (파일 크기를 바이트 단위로 정확히 표기)" IsChecked="{Binding IsBytesLogging, FallbackValue=False}" Margin="0,0,16,6"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Command Output & Start Action Bar -->
                        <Border Background="{Binding ThemeCodeBackground}" CornerRadius="12" Padding="16" BorderThickness="1" BorderBrush="{Binding ThemeBorderBrush}">
                            <DockPanel>
                                <!-- Idle / Ready State Controls -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsNotRobocopyRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button Command="{Binding CopyCommandTextCommand}" Content="📋 명령어 복사" Width="120" Height="42" Background="#334155" Foreground="White" FontSize="12" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                                    <Button Command="{Binding RunCommand}" Content="▶ 백업 실행 시작" Width="160" Height="42" Background="#10b981" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>

                                <!-- Active Running / Paused State Controls -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsRobocopyRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button Command="{Binding SwitchToLiveTabCommand}" Content="⚡ 라이브 화면 이동" Width="135" Height="42" Background="#2563eb" Foreground="White" FontSize="12" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" ToolTip="실시간 진행률 및 콘솔 스트림 탭으로 즉시 이동합니다."/>
                                    <Button Command="{Binding TogglePauseRobocopyCommand}" Content="{Binding PauseResumeButtonText}" Width="150" Height="42" Background="#d97706" Foreground="White" FontSize="12" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Robocopy 프로세스를 실시간으로 일시정지하거나 재개합니다."/>
                                    <Button Command="{Binding StopCommand}" Content="⏹ 백업 강제 중지" Width="140" Height="42" Background="#dc2626" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="진행 중인 Robocopy 프로세스를 즉시 강제 중지합니다."/>
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="최종 파싱된 Robocopy 명령어" Foreground="{Binding ThemeAccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding RobocopyCommand, Mode=OneWay}" Background="Transparent" Foreground="{Binding ThemeCodeForeground}" BorderThickness="0" FontSize="13" FontFamily="Consolas" IsReadOnly="True"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: 라이브 동기화 실행 (Live Runner) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ 라이브 동기화" VerticalAlignment="Center"/>
                        <Border Visibility="{Binding IsRobocopyRunning, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#ef4444" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="진행 중..." Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Live Backup Control Banner -->
                        <Border Grid.Row="0" Background="{Binding ThemeCardBackground}" CornerRadius="12" Padding="14,12" Margin="0,0,0,12" BorderThickness="1.5" BorderBrush="{Binding ThemeBorderBrush}">
                            <DockPanel LastChildFill="True">
                                <!-- Right: Large Action Buttons (Pause / Stop / Start) -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- When Running / Paused -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsRobocopyRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Command="{Binding TogglePauseRobocopyCommand}" Content="{Binding PauseResumeButtonText}" Height="38" Padding="16,0" Background="#d97706" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Robocopy 프로세스를 일시정지하거나 계속 재개합니다."/>
                                        <Button Command="{Binding StopCommand}" Content="⏹ 동기화 강제 중지" Height="38" Padding="16,0" Background="#dc2626" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="현재 진행 중인 Robocopy 백업 프로세스를 즉시 강제 중단합니다."/>
                                    </StackPanel>

                                    <!-- When Idle / Stopped -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsNotRobocopyRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Command="{Binding RunCommand}" Content="▶ 백업 실행 시작" Height="38" Padding="18,0" Background="#10b981" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="설정된 Robocopy 파라미터로 즉시 실시간 동기화를 시작합니다."/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Left: Status Info & Active File -->
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <TextBlock Text="⚡ 실시간 백업 컨트롤러" Foreground="{Binding ThemeForeground}" FontSize="13" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <Border Background="{Binding LiveRunnerStatusBadgeColor}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LiveRunnerStatusText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentActiveFileDetail, StringFormat={}상태: {0}}" Foreground="{Binding ThemeTextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Status Cards -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{Binding ThemeCardBackground}" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{Binding ThemeBorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="실행 진행률" Foreground="{Binding ThemeTextSecondary}" FontSize="11"/>
                                    <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}" Foreground="#10b981" FontSize="22" FontWeight="Bold" Margin="0,2,0,6"/>
                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Height="6" Background="{Binding ThemeInnerBackground}" Foreground="#10b981" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{Binding ThemeCardBackground}" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{Binding ThemeBorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="복사된 파일 수" Foreground="{Binding ThemeTextSecondary}" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding CopiedFiles}" Foreground="#38bdf8" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="/" Foreground="{Binding ThemeTextSecondary}" FontSize="16" Margin="4,4,4,0"/>
                                        <TextBlock Text="{Binding TotalFiles}" Foreground="{Binding ThemeTextSecondary}" FontSize="16" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{Binding ThemeCardBackground}" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{Binding ThemeBorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="복사된 디렉터리 수" Foreground="{Binding ThemeTextSecondary}" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                        <TextBlock Text="{Binding CopiedDirs}" Foreground="#a855f7" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="/" Foreground="{Binding ThemeTextSecondary}" FontSize="16" Margin="4,4,4,0"/>
                                        <TextBlock Text="{Binding TotalDirs}" Foreground="{Binding ThemeTextSecondary}" FontSize="16" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ProgressBar Value="{Binding DirsProgressPercent, Mode=OneWay}" Height="4" Background="{Binding ThemeInnerBackground}" Foreground="#a855f7" BorderThickness="0" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding DirsProgressText, FallbackValue='0% 완료'}" Foreground="{Binding ThemeTextSecondary}" FontSize="10"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="{Binding ThemeCardBackground}" CornerRadius="10" Padding="0,14,8,14" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{Binding ThemeBorderBrush}">
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="전송 데이터 용량" Foreground="{Binding ThemeTextSecondary}" FontSize="11"/>
                                    <TextBlock Text="{Binding CopiedBytesText}" Foreground="#f59e0b" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="{Binding ThemeCardBackground}" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{Binding ThemeBorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="현재 전송 속도" Foreground="{Binding ThemeTextSecondary}" FontSize="11"/>
                                    <TextBlock Text="{Binding CurrentSpeedText}" Foreground="#6366f1" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="5" Background="{Binding ThemeCardBackground}" CornerRadius="10" Padding="14" BorderThickness="1" BorderBrush="{Binding ThemeBorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="남은 예상 시간 (ETA)" Foreground="{Binding ThemeTextSecondary}" FontSize="11"/>
                                    <TextBlock Text="{Binding EstimatedRemainingTimeText, FallbackValue='-'}" Foreground="#38bdf8" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Realtime Output Console Terminal & Live HUD (v2.8.0 Option A) -->
                        <Border Grid.Row="2" Background="#020617" CornerRadius="12" Padding="16" BorderThickness="1" BorderBrush="#1e293b" MinHeight="450">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Row 0: Toolbar -->
                                    <RowDefinition Height="Auto" /> <!-- Row 1: Final Backup Summary Dashboard HUD (v2.8.0) -->
                                    <RowDefinition Height="Auto" /> <!-- Row 2: Live Copy Stream HUD Banner -->
                                    <RowDefinition Height="*" />    <!-- Row 3: Robocopy Log ListBox -->
                                </Grid.RowDefinitions>

                                <!-- Console Stream Header & Stream Options Toolbar -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="💻 Robocopy 프로세스 실시간 콘솔 스트림" Foreground="#38bdf8" FontSize="13" FontWeight="Bold"/>
                                        <Border Background="#0369a1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="LIVE STREAM" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- Realtime Options Checkboxes -->
                                        <CheckBox IsChecked="{Binding IsAutoScrollEnabled}" Content="⬇ 최신위치(v)" Foreground="#38bdf8" FontWeight="SemiBold" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="새 로그가 수신될 때 콘솔 화면을 항상 최신 위치로 자동 유지(실시간 자동 스크롤)합니다."/>
                                        <CheckBox IsChecked="{Binding IsLiveStreamHudEnabled}" Content="🎯 최신 전송 HUD" Foreground="#94a3b8" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="현재 전송 중인 최신 파일 정보 배너를 표시합니다."/>
                                        <CheckBox IsChecked="{Binding ShowExternalConsole}" Content="🖥️ 별도 CMD 콘솔창" Foreground="#94a3b8" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Windows 기본 명령 프롬프트 창을 별도로 띄워 네이티브 콘솔 스트림을 확인합니다."/>

                                        <Button Command="{Binding OpenSummaryHudCommand}" Content="📊 요약 통계" Width="90" Height="28" Margin="0,0,6,0" Background="#1e1b4b" Foreground="#a5b4fc" BorderThickness="1" BorderBrush="#4338ca" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="최근 완료된 Robocopy 최종 통계 대시보드 HUD를 엽니다."/>
                                        <Button Command="{Binding SaveLogCommand}" Content="💾 로그 저장" Width="85" Height="28" Margin="0,0,6,0" Background="#334155" Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                                        <Button Command="{Binding ClearLogCommand}" Content="🧹 지우기" Width="70" Height="28" Margin="0,0,6,0" Background="#334155" Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                                        <Button Command="{Binding TogglePauseRobocopyCommand}" IsEnabled="{Binding IsRobocopyRunning}" Content="{Binding PauseResumeButtonText}" Height="28" Padding="10,0" Margin="0,0,6,0" Background="#d97706" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="프로세스 일시정지/재개"/>
                                        <Button Command="{Binding StopCommand}" IsEnabled="{Binding IsRobocopyRunning}" Content="⏹ 강제 중지" Width="85" Height="28" Background="#dc2626" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="프로세스 즉시 강제 중지"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Final Backup Statistics Dashboard HUD Card (New v2.8.0 Option A) -->
                                <Border Grid.Row="1" Visibility="{Binding HasSummaryReport, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Background="#0b1329" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderThickness="1.5" BorderBrush="#10b981">
                                    <StackPanel>
                                        <!-- Header: Title, Status Badge, Action Controls -->
                                        <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📊" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="최종 백업 통계 대시보드 리포트" Foreground="#f8fafc" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                
                                                <!-- Status Badge -->
                                                <Border Background="#065f46" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SummaryReport.ExitCodeTitle}" Foreground="#34d399" FontSize="11" FontWeight="Bold"/>
                                                        <TextBlock Text=" (코드: " Foreground="#a7f3d0" FontSize="11"/>
                                                        <TextBlock Text="{Binding SummaryReport.ExitCode}" Foreground="#ffffff" FontSize="11" FontWeight="Bold"/>
                                                        <TextBlock Text=")" Foreground="#a7f3d0" FontSize="11"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Ended Time -->
                                                <TextBlock Text="{Binding SummaryReport.EndedTime, StringFormat={}완료 일시: {0}}" Foreground="#94a3b8" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Action Buttons (Right) -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding CopySummaryReportCommand}" Content="📋 리포트 복사" Width="95" Height="26" Margin="0,0,6,0" Background="#1e293b" Foreground="#38bdf8" BorderThickness="1" BorderBrush="#334155" FontSize="11" Cursor="Hand" ToolTip="전체 통계표를 텍스트 형식으로 클립보드에 복사합니다."/>
                                                <Button Command="{Binding ToggleSummaryReportCommand}" Content="{Binding SummaryToggleText}" Width="75" Height="26" Margin="0,0,6,0" Background="#1e293b" Foreground="#cbd5e1" BorderThickness="1" BorderBrush="#334155" FontSize="11" Cursor="Hand" ToolTip="상세 통계표를 접거나 펼칩니다."/>
                                                <Button Command="{Binding CloseSummaryReportCommand}" Content="✕ 닫기" Width="60" Height="26" Background="#334155" Foreground="#f1f5f9" BorderThickness="0" FontSize="11" Cursor="Hand" ToolTip="통계 대시보드 HUD 카드를 닫습니다."/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Collapsible Content Body (Visible when IsSummaryExpanded == true) -->
                                        <StackPanel Visibility="{Binding IsSummaryExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <!-- 4 Key Metric Highlight Cards -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Card 1: Dirs -->
                                                <Border Grid.Column="0" Background="#111c38" CornerRadius="8" Padding="12,10" Margin="0,0,6,0" BorderThickness="1" BorderBrush="#1e293b">
                                                    <StackPanel>
                                                        <TextBlock Text="📁 디렉터리 (Dirs)" Foreground="#94a3b8" FontSize="11"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                                            <TextBlock Text="{Binding SummaryReport.DirsCopied}" Foreground="#38bdf8" FontSize="18" FontWeight="Bold"/>
                                                            <TextBlock Text=" / " Foreground="#64748b" FontSize="13" Margin="2,4,2,0"/>
                                                            <TextBlock Text="{Binding SummaryReport.DirsTotal}" Foreground="#cbd5e1" FontSize="13" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Foreground="#64748b" FontSize="10">
                                                            <Run Text="건너뜀: "/><Run Text="{Binding SummaryReport.DirsSkipped}" Foreground="#f59e0b"/><Run Text=" · 불일치: "/><Run Text="{Binding SummaryReport.DirsMismatch}" Foreground="#cbd5e1"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Card 2: Files -->
                                                <Border Grid.Column="1" Background="#111c38" CornerRadius="8" Padding="12,10" Margin="0,0,6,0" BorderThickness="1" BorderBrush="#1e293b">
                                                    <StackPanel>
                                                        <TextBlock Text="📄 파일 (Files)" Foreground="#94a3b8" FontSize="11"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                                            <TextBlock Text="{Binding SummaryReport.FilesCopied}" Foreground="#10b981" FontSize="18" FontWeight="Bold"/>
                                                            <TextBlock Text=" / " Foreground="#64748b" FontSize="13" Margin="2,4,2,0"/>
                                                            <TextBlock Text="{Binding SummaryReport.FilesTotal}" Foreground="#cbd5e1" FontSize="13" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Foreground="#64748b" FontSize="10">
                                                            <Run Text="실패: "/><Run Text="{Binding SummaryReport.FilesFailed}" Foreground="#ef4444" FontWeight="Bold"/><Run Text=" · 추가: "/><Run Text="{Binding SummaryReport.FilesExtras}" Foreground="#38bdf8"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Card 3: Bytes -->
                                                <Border Grid.Column="2" Background="#111c38" CornerRadius="8" Padding="12,10" Margin="0,0,6,0" BorderThickness="1" BorderBrush="#1e293b">
                                                    <StackPanel>
                                                        <TextBlock Text="💾 복사 용량 (Bytes)" Foreground="#94a3b8" FontSize="11"/>
                                                        <TextBlock Text="{Binding SummaryReport.BytesCopied}" Foreground="#f59e0b" FontSize="18" FontWeight="Bold" Margin="0,4,0,2"/>
                                                        <TextBlock Foreground="#64748b" FontSize="10">
                                                            <Run Text="전체: "/><Run Text="{Binding SummaryReport.BytesTotal}" Foreground="#cbd5e1"/><Run Text=" · 건너뜀: "/><Run Text="{Binding SummaryReport.BytesSkipped}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Card 4: Speed & Time -->
                                                <Border Grid.Column="3" Background="#111c38" CornerRadius="8" Padding="12,10" BorderThickness="1" BorderBrush="#1e293b">
                                                    <StackPanel>
                                                        <TextBlock Text="⏱️ 소요 시간 &amp; 속도" Foreground="#94a3b8" FontSize="11"/>
                                                        <TextBlock Text="{Binding SummaryReport.TimesCopied}" Foreground="#a855f7" FontSize="18" FontWeight="Bold" Margin="0,4,0,2"/>
                                                        <TextBlock Foreground="#64748b" FontSize="10" TextTrimming="CharacterEllipsis">
                                                            <Run Text="속도: "/><Run Text="{Binding SummaryReport.SpeedBytesPerSec}" Foreground="#38bdf8"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Detailed 6-Column Formatted Summary Table -->
                                            <Border Background="#020617" CornerRadius="8" Padding="12,10" BorderThickness="1" BorderBrush="#1e293b">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/> <!-- Header -->
                                                        <RowDefinition Height="Auto"/> <!-- Dirs -->
                                                        <RowDefinition Height="Auto"/> <!-- Files -->
                                                        <RowDefinition Height="Auto"/> <!-- Bytes -->
                                                        <RowDefinition Height="Auto"/> <!-- Times -->
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/> <!-- 항목 -->
                                                        <ColumnDefinition Width="*"/>   <!-- 전체 -->
                                                        <ColumnDefinition Width="*"/>   <!-- 복사됨 -->
                                                        <ColumnDefinition Width="*"/>   <!-- 건너뜀 -->
                                                        <ColumnDefinition Width="*"/>   <!-- 불일치 -->
                                                        <ColumnDefinition Width="*"/>   <!-- 실패 -->
                                                        <ColumnDefinition Width="*"/>   <!-- 추가 -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Table Header Row -->
                                                    <Border Grid.Row="0" Grid.ColumnSpan="7" Background="#0f172a" CornerRadius="4" Padding="6,5" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="구분 항목" Foreground="#94a3b8" FontSize="11" FontWeight="Bold"/>
                                                            <TextBlock Grid.Column="1" Text="전체 (Total)" Foreground="#cbd5e1" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="복사됨 (Copied) 🟢" Foreground="#34d399" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="건너뜀 (Skipped) 🟡" Foreground="#fbbf24" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="불일치 (Mismatch) 🟠" Foreground="#fb923c" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                                                            <TextBlock Grid.Column="5" Text="실패 (Failed) 🔴" Foreground="#f87171" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                                                            <TextBlock Grid.Column="6" Text="추가 (Extras) 🔵" Foreground="#60a5fa" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Row 1: Dirs -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="📁 디렉터리" Foreground="#38bdf8" FontSize="11" FontWeight="Bold" Margin="4,4"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SummaryReport.DirsTotal}" Foreground="#f1f5f9" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SummaryReport.DirsCopied}" Foreground="#34d399" FontSize="11" FontWeight="Bold" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SummaryReport.DirsSkipped}" Foreground="#fbbf24" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding SummaryReport.DirsMismatch}" Foreground="#fb923c" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding SummaryReport.DirsFailed}" Foreground="#f87171" FontSize="11" FontWeight="Bold" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="6" Text="{Binding SummaryReport.DirsExtras}" Foreground="#60a5fa" FontSize="11" TextAlignment="Center" Margin="0,4"/>

                                                    <!-- Row 2: Files -->
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="📄 파일" Foreground="#38bdf8" FontSize="11" FontWeight="Bold" Margin="4,4"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SummaryReport.FilesTotal}" Foreground="#f1f5f9" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SummaryReport.FilesCopied}" Foreground="#34d399" FontSize="11" FontWeight="Bold" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SummaryReport.FilesSkipped}" Foreground="#fbbf24" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding SummaryReport.FilesMismatch}" Foreground="#fb923c" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding SummaryReport.FilesFailed}" Foreground="#f87171" FontSize="11" FontWeight="Bold" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="6" Text="{Binding SummaryReport.FilesExtras}" Foreground="#60a5fa" FontSize="11" TextAlignment="Center" Margin="0,4"/>

                                                    <!-- Row 3: Bytes -->
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="💾 바이트" Foreground="#38bdf8" FontSize="11" FontWeight="Bold" Margin="4,4"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SummaryReport.BytesTotal}" Foreground="#f1f5f9" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SummaryReport.BytesCopied}" Foreground="#34d399" FontSize="11" FontWeight="Bold" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding SummaryReport.BytesSkipped}" Foreground="#fbbf24" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding SummaryReport.BytesMismatch}" Foreground="#fb923c" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="5" Text="{Binding SummaryReport.BytesFailed}" Foreground="#f87171" FontSize="11" FontWeight="Bold" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="6" Text="{Binding SummaryReport.BytesExtras}" Foreground="#60a5fa" FontSize="11" TextAlignment="Center" Margin="0,4"/>

                                                    <!-- Row 4: Times -->
                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="⏱️ 시간" Foreground="#38bdf8" FontSize="11" FontWeight="Bold" Margin="4,4"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SummaryReport.TimesTotal}" Foreground="#f1f5f9" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SummaryReport.TimesCopied}" Foreground="#34d399" FontSize="11" FontWeight="Bold" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="-" Foreground="#64748b" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="4" Text="-" Foreground="#64748b" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="5" Text="{Binding SummaryReport.TimesFailed}" Foreground="#f87171" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="6" Text="{Binding SummaryReport.TimesExtras}" Foreground="#60a5fa" FontSize="11" TextAlignment="Center" Margin="0,4"/>
                                                </Grid>
                                            </Border>

                                            <!-- Bottom Diagnosis Bar -->
                                            <Border Background="#0f172a" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                                <DockPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="💡 상세 진단: " Foreground="#94a3b8" FontSize="11" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding SummaryReport.ExitCodeDescription}" Foreground="#cbd5e1" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#64748b" FontSize="10" VerticalAlignment="Center">
                                                        <Run Text="분당 전송 속도: "/><Run Text="{Binding SummaryReport.SpeedMegaBytesPerMin}" Foreground="#a5b4fc"/>
                                                    </TextBlock>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Live Copy Stream HUD Banner (Optionally visible) -->
                                <Border Grid.Row="2" Visibility="{Binding IsLiveStreamHudEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                        Background="#0f172a" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#1e293b">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Radar Icon -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Border Background="#10b981" Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0"/>
                                            <TextBlock Text="현재 전송 파일:" Foreground="#94a3b8" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>

                                        <!-- File Path & Detail -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentActiveFile}" Foreground="#38bdf8" FontSize="12" FontWeight="Bold" FontFamily="Consolas, Courier New" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding CurrentActiveFileDetail}" Foreground="#cbd5e1" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding EstimatedRemainingTimeText, StringFormat=' · ⏱️ ETA: {0}'}" Foreground="#38bdf8" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Latest raw console ticker -->
                                        <Border Grid.Column="2" Background="#020617" CornerRadius="6" Padding="8,4" BorderThickness="1" BorderBrush="#334155" Margin="10,0,0,0" MaxWidth="360">
                                            <TextBlock Text="{Binding LatestLogLine}" Foreground="#64748b" FontSize="10" FontFamily="Consolas, Courier New" TextTrimming="CharacterEllipsis" ToolTip="{Binding LatestLogLine}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Console ListBox with auto-scroll target Name -->
                                <ListBox x:Name="RobocopyLogListBox" Grid.Row="3" ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Foreground="#38bdf8" FontFamily="Consolas, Courier New" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" MinHeight="300">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="2"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: 백업 작업 스케줄러 (Task Scheduler & Windows Service) -->
            <TabItem Header="⏰ 백업 스케줄러">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="#1e293b" CornerRadius="12" Padding="24" Margin="0,16,0,0" BorderThickness="1" BorderBrush="#334155">
                        <StackPanel MaxWidth="850">
                            <!-- Windows Service & Execution Mode Management Panel (New v2.0.0) -->
                            <Border Background="#0f172a" CornerRadius="12" Padding="20" Margin="0,0,0,24" BorderThickness="1.5" BorderBrush="#3b82f6">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚙️ Windows 백그라운드 서비스 엔진 &amp; 동작 모드" Foreground="#60a5fa" FontSize="15" FontWeight="Bold"/>
                                            <Border Background="#2563eb" CornerRadius="8" Padding="8,3" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding ExecutionModeBadgeText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Command="{Binding CheckServiceStatusCommand}" Content="🔄 서비스 상태 확인" DockPanel.Dock="Right" Padding="10,5" Background="#334155" Foreground="White" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                                    </DockPanel>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mode Option A: Portable Mode -->
                                        <Border Grid.Column="0" Background="#1e293b" CornerRadius="8" Padding="14" Margin="0,0,6,0" BorderThickness="1" BorderBrush="#334155">
                                            <StackPanel>
                                                <RadioButton Content="🚀 포터블 앱 모드 (Portable Mode)" IsChecked="{Binding IsExecutionModePortable, Mode=TwoWay}" GroupName="ExecModeGroup" Foreground="#f8fafc" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" Command="{Binding SetExecutionModeCommand}" CommandParameter="portable"/>
                                                <TextBlock Text="GUI 앱 실행 중에만 백그라운드 타이머 및 스케줄링으로 작업합니다. 별도 서비스 설치 없이 즉시 동작합니다." Foreground="#94a3b8" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Mode Option B: Windows Service Mode -->
                                        <Border Grid.Column="1" Background="#1e293b" CornerRadius="8" Padding="14" Margin="6,0,0,0" BorderThickness="1" BorderBrush="#334155">
                                            <StackPanel>
                                                <RadioButton Content="⚙️ 윈도우 서비스 모드 (Windows Service)" IsChecked="{Binding IsExecutionModeService, Mode=TwoWay}" GroupName="ExecModeGroup" Foreground="#60a5fa" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" Command="{Binding SetExecutionModeCommand}" CommandParameter="windows_service"/>
                                                <TextBlock Text="윈도우 부팅 즉시 백그라운드 서비스(RoboBackupService)로 자동 가동되어 로그인 없이 백업을 수행합니다." Foreground="#94a3b8" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Service Status & Action Bar -->
                                    <Border Background="#020617" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#1e293b">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                    <TextBlock Text="서비스 등록 상태: " Foreground="#cbd5e1" FontSize="12" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding ServiceStatusBadgeText}" Foreground="#38bdf8" FontSize="12" FontWeight="Bold"/>
                                                    <TextBlock Text=" (RoboBackupService)" Foreground="#64748b" FontSize="11" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                    <Button Command="{Binding RegisterServiceCommand}" Content="⚙️ 서비스 등록" ToolTip="컴퓨터 재부팅 없이 즉시 백그라운드 서비스로 등록합니다." Padding="10,5" Margin="0,0,6,0" Background="#2563eb" Foreground="White" FontSize="11" FontWeight="Bold" Cursor="Hand" IsEnabled="{Binding IsNotBusy}"/>
                                                    <Button Command="{Binding StartServiceCommand}" Content="▶️ 시작" ToolTip="백그라운드 서비스를 즉시 가동합니다." Padding="10,5" Margin="0,0,6,0" Background="#10b981" Foreground="White" FontSize="11" FontWeight="Bold" Cursor="Hand" IsEnabled="{Binding IsNotBusy}"/>
                                                    <Button Command="{Binding StopServiceCommand}" Content="⏹️ 중지" ToolTip="실행 중인 백그라운드 서비스를 중지합니다." Padding="10,5" Margin="0,0,6,0" Background="#d97706" Foreground="White" FontSize="11" FontWeight="Bold" Cursor="Hand" IsEnabled="{Binding IsNotBusy}"/>
                                                    <Button Command="{Binding UninstallServiceCommand}" Content="🗑️ 삭제" ToolTip="Windows 서비스 등록을 완전히 해제합니다." Padding="10,5" Background="#dc2626" Foreground="White" FontSize="11" FontWeight="Bold" Cursor="Hand" IsEnabled="{Binding IsNotBusy}"/>
                                                </WrapPanel>
                                            </DockPanel>
                                            <TextBlock Text="💡 안내: 서비스 등록, 시작, 중지는 컴퓨터 재부팅 없이 즉시 적용됩니다. [🔄 서비스 상태 확인]을 누르면 실시간 상태 팝업을 확인할 수 있습니다." Foreground="#64748b" FontSize="11" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Windows Service Auto VSS Pre-flight & Cleanup Integration (v2.10.0) -->
                                    <Border Background="#0f172a" CornerRadius="8" Padding="12" Margin="0,10,0,0" BorderThickness="1.5" BorderBrush="#3b82f6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding IsServiceAutoVssEnabled, Mode=TwoWay}" Content="🛡️ Windows 서비스 실행 시 VSS 사전 스냅샷 자동 생성 (Auto VSS Pre-flight)" Foreground="#38bdf8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                    <Border Background="#1e3a8a" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="잠긴 DB/PST/오피스 100% 무결점 복제" Foreground="#93c5fd" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="서비스 무인 백업 집행 시 Robocopy 구동 직전 원본 볼륨의 VSS 섀도 스냅샷을 자동 생성(RoboVssProvider)하고, 복제 완료 후 스냅샷을 자동 환수하여 파일 잠김 에러(File Lock)를 100% 방지합니다." Foreground="#94a3b8" FontSize="11" Margin="22,4,0,0" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="22,6,0,0">
                                                    <TextBlock Text="현재 VSS 서비스 파이프라인: " Foreground="#64748b" FontSize="11"/>
                                                    <TextBlock Text="{Binding ServiceVssStatusBadgeText}" Foreground="#34d399" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Button Command="{Binding TestServiceVssPreflightCommand}" Content="🧪 VSS 연동 테스트" ToolTip="현재 원본 드라이브의 VSS 섀도 스냅샷 생성 및 자동 해제를 사전에 시뮬레이션 검증합니다." Padding="12,6" Margin="0,0,0,6" Background="#1e293b" BorderBrush="#38bdf8" BorderThickness="1" Foreground="#38bdf8" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                                <Button Command="{Binding EnqueueServiceJobCommand}" Content="📥 서비스 큐(Queue) 즉시 투입" ToolTip="RoboBackup Windows 백그라운드 서비스 실행 큐(%ProgramData%\RoboBackupStudio\Queue)에 VSS 백업 작업을 즉시 투입합니다." Padding="12,6" Background="#1e3a8a" BorderBrush="#60a5fa" BorderThickness="1" Foreground="#ffffff" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Windows Defender Firewall Rule Integration with explicit Version Name (v2.11.2) -->
                                    <Border Background="#090d16" CornerRadius="8" Padding="12" Margin="0,10,0,0" BorderThickness="1.5" BorderBrush="#10b981">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🛡️ Windows Defender 방화벽 예외 규칙 관리" Foreground="#34d399" FontWeight="Bold" FontSize="12"/>
                                                    <Border Background="#064e3b" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="버전 정보 포함 앱 이름 자동 등록" Foreground="#a7f3d0" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="NAS(SMB 포트 445/139), 원격 공유 폴더 및 백그라운드 서비스의 원활한 네트워크 통신을 위해 방화벽에 버전 정보가 명시된 앱 이름(예: 'RoboBackup Studio v2.16.0')으로 인바운드/아웃바운드 허용 규칙을 등록합니다." Foreground="#94a3b8" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="등록 대상 규칙 명칭: " Foreground="#64748b" FontSize="11"/>
                                                    <TextBlock Text="{Binding FirewallRuleBaseName}" Foreground="#60a5fa" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock Text=" | 상태: " Foreground="#64748b" FontSize="11" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding FirewallStatusBadgeText}" Foreground="{Binding FirewallStatusColor}" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Orientation="Horizontal">
                                                <Button Command="{Binding CheckFirewallStatusCommand}" Content="🔄 상태 확인" ToolTip="Windows Defender 방화벽에 버전 포함 규칙이 등록되어 있는지 실시간 확인합니다." Padding="10,5" Margin="0,0,6,0" Background="#334155" Foreground="White" FontSize="11" FontWeight="SemiBold" Cursor="Hand" IsEnabled="{Binding IsNotBusy}"/>
                                                <Button Command="{Binding RegisterFirewallCommand}" Content="🛡️ 방화벽 등록" ToolTip="Windows Defender 방화벽에 버전 정보가 명시된 앱 이름으로 인바운드/아웃바운드 규칙을 즉시 등록합니다." Padding="10,5" Margin="0,0,6,0" Background="#059669" Foreground="White" FontSize="11" FontWeight="Bold" Cursor="Hand" IsEnabled="{Binding IsNotBusy}"/>
                                                <Button Command="{Binding UnregisterFirewallCommand}" Content="🗑️ 규칙 해제" ToolTip="방화벽에서 해당 버전의 예외 규칙을 삭제합니다." Padding="10,5" Background="#b91c1c" Foreground="White" FontSize="11" FontWeight="Bold" Cursor="Hand" IsEnabled="{Binding IsNotBusy}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="⏰ Windows 작업 스케줄러 (schtasks.exe) 무인 자동 백업 관리" Foreground="#ffffff" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="지정된 시각에 Robocopy 백업이 자동으로 실행되도록 윈도우 스케줄러(schtasks)와 러너 배치 스크립트를 생성 및 등록합니다." Foreground="#94a3b8" FontSize="12" Margin="0,0,0,16"/>

                            <!-- STEP 1: Backup Paths Selection & Confirmation (Source & Destination) -->
                            <Border Background="#0f172a" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderThickness="1.5" BorderBrush="#38bdf8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📂 1단계: 백업 원본(Source) 및 대상(Target) 위치 지정" Foreground="#38bdf8" FontSize="14" FontWeight="Bold"/>
                                            <Border Background="#0284c7" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="필수 확인" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right" Command="{Binding SwapPathsCommand}" Content="🔄 원본 ↔ 대상 경로 맞교환" Padding="8,4" Background="#1e293b" Foreground="#94a3b8" BorderThickness="1" BorderBrush="#334155" FontSize="11" Cursor="Hand" HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <TextBlock Text="💡 안내: 첫 번째 탭 [🎯 백업 프로필 설계]의 원본/대상과 100% 실시간 연동됩니다. 스케줄 등록 전 여기서 바로 원하는 폴더를 선택하거나 변경할 수 있습니다." Foreground="#94a3b8" FontSize="11" Margin="0,0,0,12"/>

                                    <!-- Source Path Input -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="📁 백업 원본 폴더 (Source Path - 복사해올 원본 데이터 위치)" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Background="#1e293b" Foreground="#38bdf8" FontFamily="Consolas" Padding="10,7" BorderThickness="1" BorderBrush="#334155" FontSize="12"/>
                                            <Button Grid.Column="1" Command="{Binding BrowseSourceCommand}" Content="📁 원본 선택..." Padding="12,6" Margin="6,0,0,0" Background="#2563eb" Foreground="White" FontWeight="SemiBold" FontSize="11" Cursor="Hand"/>
                                            <Button Grid.Column="2" Command="{Binding OpenSourceFolderCommand}" Content="📂 열기" ToolTip="윈도우 탐색기로 원본 폴더 열기" Padding="10,6" Margin="4,0,0,0" Background="#334155" Foreground="#f8fafc" FontSize="11" Cursor="Hand"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Destination Path Input -->
                                    <StackPanel Margin="0,0,0,12">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="💾 백업 대상 저장소 폴더 (Target Path - 백업본이 안전하게 저장될 폴더)" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Command="{Binding ApplyNasPathCommand}" Content="🌐 NAS 주소 자동 입력" ToolTip="설정된 NAS 공유 경로(\\IP\Share)를 대상 폴더로 지정" HorizontalAlignment="Right" Padding="8,2" Background="#1e1b4b" Foreground="#a7f3d0" BorderBrush="#4338ca" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" Background="#1e293b" Foreground="#34d399" FontFamily="Consolas" Padding="10,7" BorderThickness="1" BorderBrush="#334155" FontSize="12"/>
                                            <Button Grid.Column="1" Command="{Binding BrowseDestinationCommand}" Content="📁 대상 선택..." Padding="12,6" Margin="6,0,0,0" Background="#059669" Foreground="White" FontWeight="SemiBold" FontSize="11" Cursor="Hand"/>
                                            <Button Grid.Column="2" Command="{Binding OpenDestinationFolderCommand}" Content="📂 열기" ToolTip="윈도우 탐색기로 대상 폴더 열기" Padding="10,6" Margin="4,0,0,0" Background="#334155" Foreground="#f8fafc" FontSize="11" Cursor="Hand"/>
                                            <Button Grid.Column="3" Command="{Binding OpenNasFolderCommand}" Content="🌐 NAS 폴더 선택..." ToolTip="NAS 네트워크 주소(\IP\Share) 내의 백업 대상 폴더를 찾아보고 선택" Padding="10,6" Margin="4,0,0,0" Background="#4338ca" Foreground="#a7f3d0" FontWeight="Bold" FontSize="11" Cursor="Hand"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Robocopy Command Summary Preview -->
                                    <StackPanel>
                                        <TextBlock Text="📋 현재 설정된 Robocopy 실행 명령어 요약 미리보기" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding RobocopyCommand, Mode=OneWay}" IsReadOnly="True" Background="#020617" Foreground="#a7f3d0" FontFamily="Consolas" FontSize="11" Padding="8" TextWrapping="Wrap" BorderThickness="1" BorderBrush="#1e293b"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- STEP 2: Scheduler Timing & Options -->
                            <Border Background="#0f172a" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#334155">
                                <StackPanel>
                                    <TextBlock Text="⏰ 2단계: 스케줄 실행 주기 및 시간 설정" Foreground="#60a5fa" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <!-- Backup Task Name Input -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="🏷️ 스케줄러 작업 등록 이름 (Task Name)" Foreground="#cbd5e1" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding BackupTaskName, UpdateSourceTrigger=PropertyChanged}" Background="#1e293b" Foreground="#38bdf8" FontFamily="Consolas" FontWeight="SemiBold" Padding="10,7" BorderThickness="1" BorderBrush="#334155" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="Windows schtasks /tn 명칭" Foreground="#64748b" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Frequency -->
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="🔄 스케줄 실행 주기" Foreground="#cbd5e1" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <ComboBox SelectedValue="{Binding ScheduleFrequency, Mode=TwoWay}" SelectedValuePath="Tag" Height="36">
                                                <ComboBoxItem Content="📅 매일 실행 (Daily)" Tag="daily" IsSelected="True"/>
                                                <ComboBoxItem Content="🗓️ 매주 실행 (Weekly)" Tag="weekly"/>
                                                <ComboBoxItem Content="📆 매월 실행 (Monthly)" Tag="monthly"/>
                                                <ComboBoxItem Content="⏱️ 매시간 실행 (Hourly)" Tag="hourly"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Start Date Selection (Calendar) -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="📅 백업 시작 날짜 (달력 선택)" Foreground="#cbd5e1" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <DatePicker SelectedDate="{Binding ScheduleStartDate}" Height="36" VerticalContentAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Clock Time Selection (Hour & Minute) -->
                                    <Border Background="#1e293b" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="#334155">
                                        <StackPanel>
                                            <TextBlock Text="🕒 백업 시작 시간 (시계 시/분 선택)" Foreground="#93c5fd" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="시간 (시)" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                                                    <ComboBox SelectedIndex="{Binding ScheduleHour}" ItemsSource="{Binding HoursList}" Height="34"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text=":" Foreground="#38bdf8" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="10,10,10,0"/>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="분 (분)" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,3"/>
                                                    <ComboBox SelectedIndex="{Binding ScheduleMinute}" ItemsSource="{Binding MinutesList}" Height="34"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <CheckBox Content="최고 관리자 권한으로 실행 (/rl HIGHEST - 시스템 권한 및 UAC 무인 우회)" IsChecked="{Binding RunWithHighestPrivileges}" Foreground="#f8fafc" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- STEP 3: Action & Task Status Monitoring -->
                            <Border Background="#0f172a" CornerRadius="10" Padding="16" Margin="0,0,0,20" BorderThickness="1" BorderBrush="#334155">
                                <StackPanel>
                                    <TextBlock Text="🚀 3단계: 작업 스케줄러 등록 &amp; 실행 테스트" Foreground="#10b981" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <!-- Action Buttons -->
                                    <Button Command="{Binding RegisterTaskCommand}" Content="📅 윈도우 작업 스케줄러에 백업 작업 등록하기 (schtasks)" Height="46" Background="#2563eb" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10" IsEnabled="{Binding IsNotBusy}"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding RunTaskNowCommand}" Content="▶️ 등록된 스케줄 지금 즉시 실행 테스트" Height="36" Margin="0,0,6,0" Background="#059669" Foreground="White" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand" IsEnabled="{Binding IsNotBusy}"/>
                                        <Button Grid.Column="1" Command="{Binding OpenTaskBatFolderCommand}" Content="📁 실행 배치 파일(.bat) 폴더 열기" Height="36" Margin="6,0,0,0" Background="#334155" Foreground="#f8fafc" FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                                    </Grid>

                                    <!-- Task Registration Status Box (Master-Detail Task List & Inspector v2.6.1) -->
                                    <Border Background="#020617" CornerRadius="8" Padding="14" BorderThickness="1" BorderBrush="#1e293b">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="📋 작업 스케줄러 등록 현황: " Foreground="#cbd5e1" FontSize="13" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding TaskStatusSummary}" Foreground="#38bdf8" FontSize="13" FontWeight="Bold"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                    <Button Command="{Binding RefreshTaskStatusCommand}" Content="🔄 새로고침" Padding="10,4" Margin="0,0,6,0" Background="#334155" Foreground="#f8fafc" Cursor="Hand" FontSize="11" IsEnabled="{Binding IsNotBusy}"/>
                                                    <Button Command="{Binding RunTaskNowCommand}" Content="▶️ 선택 작업 즉시 실행" Padding="10,4" Margin="0,0,6,0" Background="#059669" Foreground="#ffffff" Cursor="Hand" FontSize="11" FontWeight="Bold" IsEnabled="{Binding IsNotBusy}"/>
                                                    <Button Command="{Binding DeleteTaskCommand}" Content="🗑️ 선택 스케줄 삭제" Padding="10,4" Background="#991b1b" Foreground="#ffffff" Cursor="Hand" FontSize="11" IsEnabled="{Binding IsNotBusy}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Master-Detail Grid: List on Left, Inspector on Right -->
                                            <Grid MinHeight="260">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="280"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Registered Tasks ListBox -->
                                                <Border Grid.Column="0" Background="#0f172a" CornerRadius="6" BorderThickness="1" BorderBrush="#334155" Margin="0,0,10,0">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Top" Background="#1e293b" Padding="8,6" CornerRadius="6,6,0,0">
                                                            <TextBlock Text="📋 등록된 작업 목록 (클릭하여 상세 확인)" Foreground="#94a3b8" FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                        <ListBox ItemsSource="{Binding RegisteredTaskList}" SelectedItem="{Binding SelectedScheduledTask, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,2" Padding="8,6" Background="#1e293b" CornerRadius="5" BorderThickness="1" BorderBrush="#334155">
                                                                        <StackPanel>
                                                                            <DockPanel Margin="0,0,0,2">
                                                                                <TextBlock Text="{Binding TaskName}" Foreground="#38bdf8" FontWeight="Bold" FontSize="11" DockPanel.Dock="Left"/>
                                                                                <TextBlock Text="{Binding StatusBadge}" Foreground="#34d399" FontSize="10" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                                                            </DockPanel>
                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#cbd5e1" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                                            <DockPanel Margin="0,2,0,0">
                                                                                <TextBlock Text="{Binding ScheduleType}" Foreground="#a78bfa" FontSize="10" DockPanel.Dock="Left"/>
                                                                                <TextBlock Text="{Binding NextRunTime}" Foreground="#64748b" FontSize="9" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                                                            </DockPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </DockPanel>
                                                </Border>

                                                <!-- Right: Selected Task Details -->
                                                <Border Grid.Column="1" Background="#0f172a" CornerRadius="6" BorderThickness="1" BorderBrush="#334155">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Top" Background="#1e293b" Padding="10,8" CornerRadius="6,6,0,0">
                                                            <DockPanel>
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                    <TextBlock Text="🔍 선택된 작업 상세 정보: " Foreground="#94a3b8" FontSize="11" FontWeight="Bold"/>
                                                                    <TextBlock Text="{Binding SelectedScheduledTask.TaskName}" Foreground="#34d399" FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding SelectedScheduledTask.NextRunTime, StringFormat='다음 실행: {0}'}" Foreground="#38bdf8" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                        </Border>
                                                        <TextBox Text="{Binding TaskStatusDetails}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#a7f3d0" FontFamily="Consolas" FontSize="11" Padding="10" BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
                                                    </DockPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: 오래된 파일 자동정리 & 정기 스케줄러 (Auto Cleanup & Cleanup Scheduler) -->
            <TabItem Header="🧹 오래된 파일 자동정리">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0" MaxWidth="900">
                        
                        <!-- Top Banner -->
                        <Border Background="#1e293b" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#334155">
                            <StackPanel>
                                <TextBlock Text="🧹 백업/아카이브 폴더 오래된 파일 자동 정리 &amp; 정기 스케줄러" Foreground="#ffffff" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
