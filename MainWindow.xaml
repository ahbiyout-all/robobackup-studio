                                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#cbd5e1" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                                        <DockPanel Margin="0,2,0,0">
                                                                            <TextBlock Text="{Binding Frequency}" Foreground="#a78bfa" FontSize="10" DockPanel.Dock="Left"/>
                                                                            <TextBlock Text="{Binding NextRunTime}" Foreground="#64748b" FontSize="9" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                                                        </DockPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </DockPanel>
                                            </Border>

                                            <!-- Right: Selected Cleanup Task Details Inspector -->
                                            <Border Grid.Column="1" Background="#0f172a" CornerRadius="6" BorderThickness="1" BorderBrush="#334155">
