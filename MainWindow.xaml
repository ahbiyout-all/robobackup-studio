                                            <ComboBoxItem Content="📅 매일 실행 (Daily)" Tag="daily"/>
                                            <ComboBoxItem Content="🗓️ 매주 실행 (Weekly)" Tag="weekly" IsSelected="True"/>
                                            <ComboBoxItem Content="📆 매월 실행 (Monthly)" Tag="monthly"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Start Date -->
                                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
