                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="💡 5대 코어 기능 실전 업무 활용 시나리오 &amp; 사용 방법 가이드" Foreground="#34d399" FontSize="15" FontWeight="Bold"/>
                                        <Border Background="#065f46" CornerRadius="6" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="초보자 필독 가이드" Foreground="#a7f3d0" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Robocopy 일반 복사로는 해결하기 어려운 5가지 특수 상황을 마우스 클릭으로 해결합니다" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                </DockPanel>

                                <Grid Margin="0,0,0,8">
