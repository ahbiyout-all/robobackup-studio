                                                <ColumnDefinition Width="280"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Registered Cleanup Tasks ListBox -->
                                            <Border Grid.Column="0" Background="#0f172a" CornerRadius="6" BorderThickness="1" BorderBrush="#334155" Margin="0,0,10,0">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Top" Background="#1e293b" Padding="8,6" CornerRadius="6,6,0,0">
                                                        <TextBlock Text="📋 등록된 자동정리 작업 (클릭하여 상세 확인)" Foreground="#94a3b8" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                    <ListBox ItemsSource="{Binding RegisteredCleanupTaskList}" SelectedItem="{Binding SelectedRegisteredCleanupTask, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,2" Padding="8,6" Background="#1e293b" CornerRadius="5" BorderThickness="1" BorderBrush="#334155">
                                                                    <StackPanel>
                                                                        <DockPanel Margin="0,0,0,2">
                                                                            <TextBlock Text="{Binding TaskName}" Foreground="#f59e0b" FontWeight="Bold" FontSize="11" DockPanel.Dock="Left"/>
                                                                            <TextBlock Text="{Binding StatusBadge}" Foreground="#34d399" FontSize="10" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
