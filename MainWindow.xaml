                                    <Button Command="{Binding RegisterCleanupTaskCommand}" Content="📅 Windows 작업 스케줄러에 자동정리 등록" DockPanel.Dock="Right" Height="38" Padding="16,0" Background="#f59e0b" Foreground="#0f172a" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" IsEnabled="{Binding IsNotBusy}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Folder Path & Rule Thresholds -->
                        <Border Background="#1e293b" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#334155">
                            <StackPanel>
                                <TextBlock Text="⚙️ 정리 폴더 및 임계값 규칙" Foreground="#f8fafc" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="📂 정리 대상 폴더 경로" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding CleanupFolderPath, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="#f8fafc" Padding="10,8" BorderThickness="1" BorderBrush="#334155" FontSize="13"/>
                                        <Button Grid.Column="1" Command="{Binding BrowseCleanupFolderCommand}" Content="📁 찾아보기..." Padding="16,0" Margin="8,0,0,0" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                    </Grid>
                                </StackPanel>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" Background="#0f172a" CornerRadius="8" Padding="14" Margin="0,0,8,0" BorderThickness="1" BorderBrush="#334155">
                                        <StackPanel>
                                            <TextBlock Text="⚙️ 삭제 조건 규칙 [기간 / 용량 / 모두]" Foreground="#cbd5e1" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                            <RadioButton Content="📅 기간 기준 (N일 이상 경과 파일 삭제)" IsChecked="{Binding IsCleanupTypeDays, Mode=TwoWay}" GroupName="CleanupTypeGroup" Foreground="#f8fafc" Margin="0,0,0,6" ToolTip="지정된 일수 이전의 수정 시간을 가진 아카이브 파일만 선별 삭제합니다."/>
                                            <RadioButton Content="💾 용량 기준 (총 N GB 초과 시 오래된 파일부터 삭제)" IsChecked="{Binding IsCleanupTypeSize, Mode=TwoWay}" GroupName="CleanupTypeGroup" Foreground="#f8fafc" Margin="0,0,0,6" ToolTip="폴더 내 총 파일 용량이 한계치를 넘을 경우, 가장 오래된 파일부터 순차 삭제하여 용량을 확보합니다."/>
                                            <RadioButton Content="⚡ 모두 적용 (기간 초과 삭제 + 용량 초과 시 오래된 순 삭제)" IsChecked="{Binding IsCleanupTypeBoth, Mode=TwoWay}" GroupName="CleanupTypeGroup" Foreground="#a7f3d0" FontWeight="SemiBold" ToolTip="N일 경과 파일을 우선 삭제한 후에도 총 용량이 한계치를 넘을 경우 오래된 파일부터 추가로 삭제합니다."/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#0f172a" CornerRadius="8" Padding="14" Margin="8,0,0,0" BorderThickness="1" BorderBrush="#334155">
                                        <StackPanel>
                                            <TextBlock Text="📊 상세 임계값 설정" Foreground="#cbd5e1" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                            
                                            <StackPanel Margin="0,0,0,8">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCleanupTypeDays}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCleanupTypeBoth}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="보존 기간 (일 수):" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding CleanupDays, UpdateSourceTrigger=PropertyChanged}" Background="#1e293b" Foreground="#38bdf8" Padding="8" FontSize="13" BorderThickness="1" BorderBrush="#334155" ToolTip="보존 기간 설정: 지정된 일수보다 오래된 파일을 선별 삭제합니다."/>
                                            </StackPanel>

                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCleanupTypeSize}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCleanupTypeBoth}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="최대 허용 용량 (GB):" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding CleanupMaxGb, UpdateSourceTrigger=PropertyChanged}" Background="#1e293b" Foreground="#fbbf24" Padding="8" FontSize="13" BorderThickness="1" BorderBrush="#334155" ToolTip="최대 용량 설정: 폴더 용량이 지정된 GB를 초과할 경우 오래된 파일부터 삭제합니다."/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding ScanCleanupFilesCommand}" Content="🔍 수동 대상 파일 스캔 (미리보기)" Height="40" Margin="0,0,6,0" Background="#2563eb" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand" IsEnabled="{Binding IsNotBusy}"/>
                                    <Button Grid.Column="1" Command="{Binding ExecuteCleanupCommand}" Content="⚠️ 오래된 파일 즉시 영구 삭제" Height="40" Margin="6,0,0,0" Background="#dc2626" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand" IsEnabled="{Binding IsNotBusy}"/>
                                </Grid>

                                <Border Background="#0f172a" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#334155">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CleanupStatusSummary}" Foreground="#38bdf8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ListBox ItemsSource="{Binding CleanupPreviewList}" Height="140" Background="#020617" Foreground="#cbd5e1" FontFamily="Consolas" FontSize="11" BorderThickness="1" BorderBrush="#1e293b"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: 코어 DLL 스튜디오 (Core DLL Modules Suite) -->
            <TabItem Header="🧩 코어 DLL 스튜디오">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,0">
                        
                        <!-- Header Banner -->
                        <Border Background="#1e293b" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#334155">
                            <DockPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🧩 엔터프라이즈 전용 코어 DLL 모듈 스위트" Foreground="#f8fafc" FontSize="16" FontWeight="Bold"/>
                                        <Border Background="#10b981" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="v2.16.0 Core Suite &amp; Wizard Studio" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Robocopy 실행 전후의 안전성과 성능을 극대화하는 5대 고성능 순수 C# 네이티브 코어 엔진 모듈입니다. 모듈별 단계별 마법사로 안전하게 설정하세요." Foreground="#94a3b8" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Master 5 Core DLL Wizard Launcher Card (v2.9.0) -->
                        <Border Background="#1e293b" CornerRadius="12" Padding="18" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#3b82f6">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🧙‍♂️ 5대 코어 DLL 모듈별 기능 사용 마법사 (Wizard Studio)" Foreground="#60a5fa" FontSize="15" FontWeight="Bold"/>
                                        <Border Background="#2563eb" CornerRadius="6" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="단계별 가이드 &amp; 사전 검증" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="원하는 모듈을 선택하여 3단계 인터랙티브 마법사를 시작하세요" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                </DockPanel>

                                <UniformGrid Columns="5" Margin="0,0,0,4">
                                    <Button Command="{Binding OpenCoreDllWizardCommand}" CommandParameter="diff" Height="50" Margin="0,0,6,0" Background="#0f172a" BorderBrush="#38bdf8" BorderThickness="1.5" Cursor="Hand">
                                        <TextBlock Text="🚀 1. 차이 분석&#10;(RoboDiffEngine)" TextAlignment="Center" Foreground="#38bdf8" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                    <Button Command="{Binding OpenCoreDllWizardCommand}" CommandParameter="vss" Height="50" Margin="0,0,6,0" Background="#0f172a" BorderBrush="#a855f7" BorderThickness="1.5" Cursor="Hand">
                                        <TextBlock Text="🛡️ 2. VSS 스냅샷&#10;(RoboVssProvider)" TextAlignment="Center" Foreground="#c084fc" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                    <Button Command="{Binding OpenCoreDllWizardCommand}" CommandParameter="syncwatch" Height="50" Margin="0,0,6,0" Background="#0f172a" BorderBrush="#f59e0b" BorderThickness="1.5" Cursor="Hand">
                                        <TextBlock Text="⚡ 3. 실시간 감시&#10;(RoboSyncWatch)" TextAlignment="Center" Foreground="#fbbf24" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                    <Button Command="{Binding OpenCoreDllWizardCommand}" CommandParameter="vault" Height="50" Margin="0,0,6,0" Background="#0f172a" BorderBrush="#10b981" BorderThickness="1.5" Cursor="Hand">
                                        <TextBlock Text="🔐 4. 보안 볼트&#10;(RoboVault DPAPI)" TextAlignment="Center" Foreground="#34d399" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                    <Button Command="{Binding OpenCoreDllWizardCommand}" CommandParameter="timemachine" Height="50" Background="#0f172a" BorderBrush="#ec4899" BorderThickness="1.5" Cursor="Hand">
                                        <TextBlock Text="⏳ 5. 타임머신&#10;(RoboTimeMachine)" TextAlignment="Center" Foreground="#f472b6" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
